# SLURM cluster settings for singer-snakemake on the SHARED caslake partition.
#
#   bash scripts/run_singer.sh <SET> --config slurm_caslake
#
# This is a snakemake profile body. run_singer.sh stages it into a temporary directory as
# `config.yaml`, because --profile takes a directory, not a file. To use it by hand:
#   mkdir -p /tmp/prof && cp drivers/slurm_caslake.config /tmp/prof/config.yaml
#   snakemake ... --profile /tmp/prof
#
# caslake is 190 nodes x 48 CPU / 184 GB (3.84 GB per CPU), MaxTime unlimited, and shared with
# the rest of the cluster. On a shared partition the scheduler favours small, cheap requests:
# a 1-CPU job asking 4 GB backfills into gaps that a 16-CPU or 64 GB job waits hours for. Every
# rule in this workflow is single-threaded (none declares `threads`), so asking for one CPU
# each is not a compromise -- it is what the work actually is.
#
# The per-rule resources below are sized from a COMPLETED ALL (n=216, 2 Mb chunks, chr21) run
# -- measured, not guessed. On a shared partition the scheduler favours small requests: a job
# asking 8 GB / 10 h backfills into gaps that a 14 GB / 36 h job waits behind, and every rule
# here is single-threaded (none declares `threads`), so one CPU each is what the work is.
#
#     rule                 n    median        max        requested here
#     run_singer          16    3.8 h  3.7 GB  5.8 h  5.4 GB    10 h, 12 GB  (see below)
#     run_polegon        256    0.7 min  313 MB  1.2 min 346 MB   30 min, 1 GB
#     chunk_chromosomes    1    ~2 min   ~35 MB (chr22)           4 h,   8 GB
#
# Two notes on the sizing:
#
#  * run_singer's 10 h / 8 GB is ~1.7x the observed maximum on both axes. Chunks are a FIXED
#    2 Mb, so a chunk from chr1 should cost about what a chunk from chr21 costs -- the per-chunk
#    figures do not scale with chromosome length. The headroom covers chunks with unusually high
#    variant density, not longer chromosomes.
#  * chunk_chromosomes keeps 8 GB despite measuring ~35 MB on chr22: it builds a
#    full-chromosome numpy <U1 array from the ancestral FASTA plus the whole genotype matrix,
#    and chr1 is 5x longer than chr22. This is the one rule whose cost DOES scale with
#    chromosome length, so it keeps generous memory.

# run_singer memory: 12 GB, raised from 8 GB after 8 GB proved too tight.
#
# MaxRSS over 576 COMPLETED run_singer jobs on the ALL whole-genome run:
#
#     p50   1.90 GB      p95   3.65 GB
#     p90   3.41 GB      p99   4.93 GB      max  6.81 GB
#
# The distribution is tight (mean 2.09, sd 0.92) but the tail reaches 6.81 GB, and at the
# original 8000 MB request that left a 2% margin. ~7.5% of run_singer jobs were killed by the
# cgroup. The tell is counter-intuitive: killed jobs record a LOWER MaxRSS (5.1-6.25 GB) than
# successful ones, because sacct reports the last sample taken before the fatal allocation,
# not the allocation that killed it. SINGER's own log even ends with "return code: 0" -- the
# wrapper writes that line before checking outputs -- while the chunk has none of its 64
# numbered output files, only the `_start_*` ones.
#
# Those figures are ALL's, at 432 haplotypes. SINGER holds the ARG for the whole sample in
# memory, so the requirement scales with haplotype count and a single constant is wrong across
# 8 sets spanning 28 to 216 diploids: AMERICA (122 haplotypes) measured 0.87-1.32 GB against a
# 12 GB request. scripts/run_singer.sh therefore sizes this per set, proportionally from the
# ALL anchor (15.76 MB per haplotype) with 2x headroom and a 4 GB floor.
#
# Over-requesting is not free even where it fits: memory, not CPUs, is what limits how many
# jobs a node holds, so an oversized request leaves CPUs idle while jobs queue.
#
# Instead of paying for that tail on every job, the request ESCALATES on retry:
#
#     attempt 1   12 GB     1.8x observed max
#     attempt 2   20 GB     2.9x
#     attempt 3   28 GB     4.1x
#
# with `retries: 2` above. A chunk that genuinely needs more memory gets it automatically on
# the next attempt; the other ~99% never pay for headroom they do not use. This matters because
# retries default to 0, which is what turned the earlier OOM kills into permanent failures
# rather than something the workflow healed by itself.
#
# Note the failure signature, because it is misleading: a killed job records a LOWER MaxRSS than
# a successful one (sacct reports the last sample before the fatal allocation), and SINGER's own
# log still ends "return code: 0". The reliable tell is a chunk directory holding only the
# `_start_*` files and none of the 64 numbered outputs.
#
# If a chunk still dies at 28 GB, treat it as a different regime and investigate that chunk
# rather than raising the ceiling again.

executor: slurm
retries: 2                     # see the run_singer memory note: attempt 2 and 3 get more memory
jobs: 500                      # caslake has 9120 CPUs; 500 concurrent single-CPU jobs is polite
# Job submission rate: 25/s, raised from snakemake's default of 5.
#
# POLEGON jobs last ~10 s. To keep N slots busy at that duration snakemake must submit roughly
# N/10 jobs per second -- ~19/s for a 190-slot partition. At 5/s the partition could only stay
# about a quarter full: measured throughput was ~3,700 jobs/h while 130 of 192 CPUs sat idle
# and jobs queued on Priority. Long jobs never hit this: run_singer at ~30 min needs 0.1/s.
#
# max-status-checks-per-second is raised from 0.5 to 2 for the same reason -- at 190 concurrent
# jobs finishing every ~10 s, a 2-second polling interval cannot notice completions fast enough
# to refill the queue.
#
# Both are load on the shared SLURM controller, so do not raise them further without need. The
# real fix for a short-job phase is fewer, larger jobs (see singer-mcmc-samples in
# drivers/singer_config.yaml, which sets how many POLEGON jobs exist at all).
max-jobs-per-second: 25
max-status-checks-per-second: 2
latency-wait: 60               # shared filesystem under load can lag
keep-going: true               # one failed chunk should not stop the rest
rerun-incomplete: true
printshellcmds: true

default-resources:
    slurm_account: pi-jnovembre
    slurm_partition: caslake
    cpus_per_task: 1
    mem_mb: 2000
    runtime: 240

set-resources:
    chunk_chromosomes:
        mem_mb: 8000
        runtime: 240
    run_singer:
        # OVERRIDDEN PER SAMPLE SET -- scripts/run_singer.sh rewrites this line when it stages
        # the profile, sizing it from the set's haplotype count (see mem_for_set there, and the
        # memory note above). The value here is only the fallback for a set it cannot size: it
        # is ALL's figure, the largest, so an unrecognised set is over-provisioned, not killed.
        mem_mb: 14000 + 8000 * (attempt - 1)
        runtime: 600           # 10 h; observed max 5.8 h. Well under the 36 h QOS ceiling,
                               # which means it backfills instead of waiting for a long slot.
    run_polegon:
        mem_mb: 1000           # observed max 346 MB
        runtime: 30            # observed max 1.2 min
    merge_chunks:
        mem_mb: 8000
        runtime: 720
    observed_tree_statistics:
        mem_mb: 4000
    expected_tree_statistics:
        mem_mb: 4000
    coalescence_rates:
        mem_mb: 4000
    diagnostics:
        mem_mb: 4000
