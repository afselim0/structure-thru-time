# SLURM cluster settings for the DEDICATED jnovembre partition (192 CPUs, 3 nodes).
#
#   bash scripts/run_singer.sh <SET> --config slurm_jnovembre     (this is the default)
#
# This is a snakemake profile body. run_singer.sh stages it into a temporary directory as
# `config.yaml`, because --profile takes a directory, not a file. To use it by hand:
#   mkdir -p /tmp/prof && cp drivers/slurm_jnovembre.config /tmp/prof/config.yaml
#   snakemake ... --profile /tmp/prof
#
# Use this when you own the partition and want predictable scheduling: nothing else is
# competing, so jobs start immediately and the only limit is the 192 CPUs. Use
# slurm_caslake instead when you need throughput -- caslake has 9,120 CPUs but is shared,
# so jobs queue.
#
# Per-rule resources are sized from measured MaxRSS and Elapsed on a completed ALL
# (n=216, 2 Mb chunks) run -- the same measurements the caslake profile uses:
#
#     rule                measured max        requested here
#     run_singer          5.8 h / 5.4 GB      12 h / 8 GB
#     run_polegon         1.2 min / 346 MB    30 min / 1 GB
#     chunk_chromosomes   ~2 min / ~35 MB     4 h / 8 GB
#
# chunk_chromosomes keeps generous memory on purpose: it is the one rule whose cost scales
# with chromosome length, building a full-chromosome numpy <U1 array from the ancestral FASTA
# plus the whole genotype matrix, and chr1 is 5x chr21. Everything else runs on fixed-size
# 2 Mb chunks, so its cost does not grow with the chromosome.
#
# Walltime headroom: the jnovembre QOS allows 2-00:00:00 (48 h), more generous than caslake's
# 36 h, so run_singer gets 12 h -- about 2x the observed maximum. Check your own limit with
#     sacctmgr show qos <your-qos> format=MaxWall
executor: slurm
retries: 2                  # run_singer escalates memory on retry; see slurm_caslake.config
jobs: 190                   # just under the partition's 192 CPUs; every rule is 1 CPU
max-jobs-per-second: 5
max-status-checks-per-second: 0.5
latency-wait: 30            # project filesystem can lag on output visibility
keep-going: true            # one failing chunk should not halt the rest
rerun-incomplete: true
printshellcmds: true

default-resources:
    slurm_account: pi-jnovembre
    slurm_partition: jnovembre
    cpus_per_task: 1
    mem_mb: 2000
    runtime: 240

set-resources:
    chunk_chromosomes:
        mem_mb: 8000
        runtime: 240
    run_singer:
        # OVERRIDDEN PER SAMPLE SET. scripts/run_singer.sh rewrites this line when it stages
        # the profile, sizing it from the set's haplotype count (see mem_for_set there). The
        # value below is only the fallback for a set it cannot size -- it is ALL's figure, the
        # largest, so an unrecognised set is over-provisioned rather than killed.
        #
        # Why per set: a jnovembre node has 257 GB and 64 CPUs, so memory, not CPUs, decides
        # how many jobs fit. At a flat 12 GB only 21 jobs fit per node -- 63 across the
        # partition -- leaving 129 CPUs idle while jobs queued on Priority. AMERICA (61
        # diploids) measured 0.87-1.32 GB against that 12 GB request; sized at 4 GB it gets
        # 192 concurrent slots instead of 63, and the partition becomes CPU-bound as it should.
        mem_mb: 14000 + 8000 * (attempt - 1)
        runtime: 720           # 12 h; observed max 5.8 h
    run_polegon:
        mem_mb: 1000           # observed max 346 MB
        runtime: 30            # observed max 1.2 min
    merge_chunks:
        mem_mb: 8000
        runtime: 720
    observed_tree_statistics:
        mem_mb: 4000
    expected_tree_statistics:
        mem_mb: 4000
    coalescence_rates:
        mem_mb: 4000
    diagnostics:
        mem_mb: 4000
