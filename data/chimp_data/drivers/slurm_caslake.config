# SLURM cluster settings for the SHARED caslake partition (9,120 CPUs).
#
#   bash scripts/run_singer.sh --config slurm_caslake
#
# This is a snakemake profile body. run_singer.sh stages it into a temporary directory as
# `config.yaml`, because --profile takes a directory, not a file. To use it by hand:
#   mkdir -p /tmp/prof && cp drivers/slurm_caslake.config /tmp/prof/config.yaml
#   snakemake ... --profile /tmp/prof
#
# Use this when you need THROUGHPUT: 9,120 CPUs against jnovembre's 192, so the whole genome
# can be in flight at once. The cost is queueing -- jobs wait behind other users, and a launch
# can sit pending for hours. Use slurm_jnovembre when you want predictable start times.
#
# Requesting one CPU and right-sized memory per rule (rather than one big blanket allocation)
# is what makes this work on a shared queue: small jobs backfill into gaps that a large
# request cannot use.
#
# ---------------------------------------------------------------------------------------
# Per-rule resources, sized from MEASURED values on the 54-chimpanzee panel (1,600 MCMC
# iterations, ~958 chunks genome-wide):
#
#     rule                measured                    requested here
#     run_singer          1.3 h p50, 18.3 h p99     36 h / 12 GB
#     run_polegon         ~1 min / <1 GB              30 min / 2 GB
#     chunk_chromosomes   length-scaling, ~8 GB peak  4 h / 16 GB
#     merge_chunks        50.9-57.6 GB  <-- SEE BELOW  12 h / 72 GB, escalating
#
# merge_chunks is why this file exists. The first genome-wide attempt ran one sbatch array
# task per chromosome at a flat --mem=56G, which meant every rule shared one number sized
# from run_singer's per-chunk cost. merge_chunks does not scale that way: it loads per-chunk
# tree sequences to concatenate them, so its peak tracks TOTAL CHROMOSOME SIZE, not chunk
# size. Six of 23 chromosomes were OOM-killed there (chr5, chr6, chr7, chr8, chr10, chr11),
# each after 12-16 h of completed inference.
#
# The margin was nil rather than merely tight: chr2B SURVIVED at 57.1 GB while chr5 DIED at
# 56.6 GB. Same limit, opposite outcomes -- the flat number was not separating well-behaved
# chromosomes from badly-behaved ones, it was a coin flip on which merge jobs happened to be
# in flight. Rather than pay a flat worst-case on every merge, the request ESCALATES on retry:
#
#     attempt 1   72 GB    1.25x observed max
#     attempt 2   112 GB   1.9x
#     attempt 3   152 GB   2.6x
#
# with `retries: 2` below. A chromosome that genuinely needs more gets it automatically on the
# next attempt, and the retry is cheap: merge_chunks is parameterised per replicate, and the
# SINGER and POLEGON outputs it consumes survive on disk, so a re-run redoes minutes of merging
# rather than the 12-16 h of inference behind it.
#
# retries defaults to 0, which is what turned the first run's OOM kills into PERMANENT failures
# rather than something the workflow healed by itself. That is the single most important line
# in this file.
#
# Walltime: the caslake QOS ceiling is 36 h, tighter than jnovembre's 48 h. run_singer's 20 h
# and merge_chunks' 12 h both sit under it, so the two profiles agree here. Check your own
# limit with
#     sacctmgr show qos <your-qos> format=MaxWall
executor: slurm
retries: 2                  # merge_chunks escalates memory on retry; see the note above
jobs: 500                   # shared partition: cap our own footprint rather than the node count
max-jobs-per-second: 5
max-status-checks-per-second: 0.5
latency-wait: 30            # project filesystem can lag on output visibility
keep-going: true            # one failing chunk should not halt the rest
rerun-incomplete: true
printshellcmds: true

default-resources:
    slurm_account: pi-jnovembre
    slurm_partition: caslake
    # No QOS here. The snakemake SLURM executor sets it itself and REJECTS any attempt to
    # pass --quality-of-service (or --qos) through slurm_extra, failing every submission with
    # "The --quality-of-service option is not allowed in the 'slurm_extra' parameter."
    # The sbatch scripts under scripts/ still carry #SBATCH --qos=caslake because they invoke
    # sbatch directly, where it is fine; only the executor objects.
    cpus_per_task: 1
    mem_mb: 2000
    runtime: 240

set-resources:
    chunk_chromosomes:
        mem_mb: 16000          # scales with chromosome length: full-chromosome arrays
        runtime: 240
    run_singer:
        mem_mb: 12000          # observed 2.4-4.5 GB per chunk
        # 36 h. Sized from MEASURED chimpanzee chunks, n=7,255 completed at 5,000 iterations:
        #
        #     p50 1.3 h | p90 11.5 h | p99 18.3 h
        #
        # An earlier 20 h here was transferred from the HUMAN distribution (p50 1.71 h,
        # p90 3.36 h, max 17.15 h) on the reasoning that n=54 vs n=216 would offset 3 Mb vs
        # 2 Mb chunks. The medians do match -- but the chimpanzee TAIL is 3.4x heavier at
        # p90, and 20 h walltime-killed 10 chunks outright with ~24 more about to follow.
        #
        # The lesson is about the tail, not the median: a walltime has to cover p99+, and a
        # median that transfers cleanly says nothing about whether the tail does. 24 h would
        # clear every observed chunk; 36 h is used because on a shared partition the cost of
        # over-requesting is scheduling latency, while the cost of under-requesting is losing
        # a chunk that has already burned 20 h -- an asymmetry that favours headroom.
        #
        # 35 h, not 36: the caslake QOS MaxWall is exactly 1-12:00:00 (36 h), and a request
        # AT the ceiling is rejected outright rather than truncated. jnovembre's 48 h QOS
        # leaves room for the full 36 there.
        runtime: 2100
    run_polegon:
        mem_mb: 2000
        runtime: 30
    merge_chunks:
        # 72 GB, then 112 and 152 on retry. See the memory note above.
        mem_mb: 72000 + 40000 * (attempt - 1)
        runtime: 720
    observed_tree_statistics:
        mem_mb: 8000
    expected_tree_statistics:
        mem_mb: 8000
    coalescence_rates:
        mem_mb: 8000
    diagnostics:
        mem_mb: 8000
