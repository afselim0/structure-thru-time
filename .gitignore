# ---------------------------------------------------------------------------
# Editors, caches, job logs
# ---------------------------------------------------------------------------
*.pyc
*.DS_Store
*.ipynb
job_logs/
*.err
*.out
*.log
*.snakemake*

# ---------------------------------------------------------------------------
# Run outputs
# ---------------------------------------------------------------------------
results/outputs/
results/figures/sim_figs_png/
results/figures/app_figs_png/
finished_sim.txt
finished_infer.txt

# Per-run colour/label tables written next to the outputs.
pop_colors.csv
pop_labels.csv

# ---------------------------------------------------------------------------
# Data formats
#
# Blanket rules by extension. Anything re-included below is an exception that
# the manuscript depends on.
# ---------------------------------------------------------------------------
*.parquet
*.html
*.pdf
*.txt
*.mp4
*.zip

# Tree sequences and tree-inference intermediates
*.trees
*.hap
*.map
*.mut
*.sample
*.anc
*.vcf

# ---------------------------------------------------------------------------
# Exceptions: manuscript figures
#
# Tracked despite the blanket *.pdf rule. A directory must be re-included
# before the files within it can be.
# ---------------------------------------------------------------------------
!results/figures/sim_figs/
!results/figures/sim_figs/*.pdf
!results/figures/app_figs/
!results/figures/app_figs/*.pdf

# ---------------------------------------------------------------------------
# Exceptions: prepared figure data
#
# results/figure_data/ is the provenance of the manuscript figures, so the
# small label, colour and parameter tables are tracked. The large numeric
# tables are .parquet and stay ignored: they are regenerable from
# results/outputs/ by the matching script in utils/runs/prepare_figure_data/.
# ---------------------------------------------------------------------------
!results/figure_data/
!results/figure_data/**/
!results/figure_data/README.md
!results/figure_data/**/*.csv
!results/figure_data/**/*.yaml

# ---------------------------------------------------------------------------
# Human data preparation (data/human_data/)
#
# The scripts, drivers and recorded decisions are tracked; the data they fetch
# and derive is not. resources/ alone is ~15 GB (a 6.3 GB source VCF, the
# per-chromosome BCFs, and ~700 MB of ancestral FASTA), and every byte of it is
# reproducible with `bash download.sh` -- bar the deCODE map, which science.org
# blocks and a human must place at resources/raw/aau1043_datas3.gz by hand.
# ---------------------------------------------------------------------------
data/human_data/resources/
data/human_data/SingerSnakemake_SampleSets/
data/human_data/results/
data/human_data/logs/
data/human_data/.scratch/

# Snakemake per-run state lives OUTSIDE the repo entirely (scripts/run_singer.sh puts it under
# $SCRATCH), so there is nothing to ignore here: each set needs its own workdir because they
# race on .snakemake/iocache, and that state is large and regenerable. Which chunks are already
# finished is recorded by the `.singer.done` sentinels under results/, not by the workdir.

# Tracked despite the blanket rules above.
!data/human_data/README.md
!data/human_data/drivers/prep.yaml
!data/human_data/drivers/singer_config.yaml
!data/human_data/drivers/*.config

# Chimpanzee data preparation (data/chimp_data/). Same shape as the human block above:
# everything derived or downloaded is ignored, and only the documentation and the drivers
# that rebuild it are tracked. resources/vcf/ holds a ~28 GB copy of the raw callset, and
# intermediates/ another ~46 GB of per-chromosome working files.
# NOTE: the trailing pattern excludes CONTENTS but re-includes the directory itself, because
# git does not descend into an excluded directory and a negation inside one is never seen.
data/chimp_data/resources/*
# ...except the small hand-built sample metadata, which is an INPUT rather than something
# the drivers regenerate: the population labels/colours CoaSTT reads, and the sample
# locations, which took a two-step accession -> BioSamples -> de Manuel supplement join to
# reconstruct (see resources/samples/LOCATIONS.md).
!data/chimp_data/resources/samples/
data/chimp_data/resources/samples/*
!data/chimp_data/resources/samples/*.csv
!data/chimp_data/resources/samples/*.tsv
!data/chimp_data/resources/samples/*.txt
!data/chimp_data/resources/samples/*.md
data/chimp_data/intermediates/
data/chimp_data/SingerSnakemake_Input/
data/chimp_data/results/
data/chimp_data/logs/
# Legacy: the first genome-wide run's per-chromosome snakemake workdirs. Superseded by a
# scratch workdir outside the repo; drivers/0_cleanup_legacy.sh removes the directory.
data/chimp_data/runs/

# Tracked despite the blanket rules above. drivers/ is the reproduction path -- the numbered
# wrappers, the two SLURM profiles, singer_config.yaml and prep.yaml -- so all of it is kept.
# The profiles are .config rather than .yaml so the blanket rules leave them alone.
!data/chimp_data/README.md
!data/chimp_data/drivers/
!data/chimp_data/drivers/**

# ---------------------------------------------------------------------------
# Scratch, tests, local-only data
# ---------------------------------------------------------------------------
tests/
results/.tests
.misc/
local_data/
*old*
/sandbox
/docs/plans
data/configs/sim_test_configs/
data/configs/app_test_configs/
*(jnovembre@uchicago.edu)*

