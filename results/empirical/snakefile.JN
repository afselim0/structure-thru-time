import os

INPUT_TAG = config["input_tag"]
POP_COLORS = f"{INPUT_TAG}.pop_colors.csv"
POP_LABELS = f"{INPUT_TAG}.pop_labels.csv"
TREES_DIR = config["trees_dir"] if "trees_dir" in config else f"../../data/{INPUT_TAG}/trees"

## STT Parameters
FRACTION_PAIRS = config["fraction_pairs"] if "fraction_pairs" in config else 1
WINDOW_SIZE = config["window_size"] if "window_size" in config else 100
N0 = config["N0"] if "num_contigs" in config else 1
MIN_TIME = config["min_time"] if "min_time" in config else 1
MAX_TIME = config["max_time"] if "max_time" in config else 20000
N_TIMEPOINTS = config["n_timepoints"] if "n_timepoints" in config else 1000
N_POSTERIOR_SAMPLES = config["num_posterior_samples"] if "num_posterior_samples" in config else 1

PDF_INFER_TAG = f"FP{FRACTION_PAIRS}"
RATES_INFER_TAG =f"FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}"
EMBEDDINGS_INFER_TAG = f"FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}.N0{N0}"

PDF_INFER_FILE           = f"pdf_infer.{PDF_INFER_TAG}.parquet"
RATES_INFER_FILE         = f"rates_infer.{RATES_INFER_TAG}.parquet"
EMBEDDINGS_INFER_FILE    = f"embeddings_infer.{EMBEDDINGS_INFER_TAG}.parquet"

pops = config["pops"]
pops = pops.replace(","," ")
n_samples = config["n_samples"]
OUTPUT_DIR=f"{INPUT_TAG}_tmp"


pdf_data = os.path.join(output_dir,"pdf.parquet")
rates_data = os.path.join(output_dir,"rates.parquet")
rates_plot = os.path.join(output_dir,"rates.png")
embeddings_data = os.path.join(output_dir,"embeddings.parquet")
embeddings_3d_plot = os.path.join(output_dir,"embeddings.html")
embeddings_static_plot = os.path.join(output_dir,"embeddings.png")

# Main Script Paths
CountCoalEvents_SCRIPT = "../../src/CountCoalEvents.py"
COMPUTE_RATES_SCRIPT = "../../src/compute_coal_rates.py"
COMPUTE_EMBEDDINGS_SCRIPT = "../../src/LatentSpaceEmbeddings.py"
PLOT_EMBEDDINGS_SCRIPT = "../../src/PlotEmbeddings.py"

# Fixed params
window_size = 500
n_timepoints = 6000



rule all:
    input:
        pdf_data,
        rates_data,
        rates_plot,
        embeddings_data,
        embeddings_3d_plot

rule compute_pdf:
    input:
        main_script = CountCoalEvents_SCRIPT,
        script = "../../utils/compute_pdf.py"
    params:
        trees_dir = TREES_DIR,
        output_dir = OUTPUT_DIR,
        output_name = PDF_INFER_FILE,
        max_time = MAX_TIME,
        n_samples = N_SAMPLES,
        n_timepoints = N_TIMEPOINTS,
        num_posterior_samples = NUM_POSTERIOR_SAMPLES,
        fraction_pairs = FRACTION_PAIRS,
        pops = pops,
        pop_labels = POP_LABELS

    output:
        pdf_data
    shell:
        """
        python {input.script} \
            --input_path {params.trees_dir} \
            --output_path {params.output_dir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
            --pops {params.pops} \
            --n_samples_per_pop {params.n_samples} \
            --fraction_pairs {params.fraction_pairs} \
            --pop_labels {params.pop_labels}
        """

rule compute_rates:
    input:
        pdf_data=pdf_data,
        script="../../utils/compute_rates.py",
        main_script=COMPUTE_RATES_SCRIPT
    output:
        rates_data
    params:
        outdir=OUTPUT_DIR,
        output_name=RATES_INFER_FILE,
        window_size=window_size
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_data} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --window_size {params.window_size} 
        """

rule plot_rates:
    input:
        rates=rates_data,
        pop_colors=pop_colors,
        pop_labels=pop_labels,
        script="../../utils/plot_rates.py"
    output:
        rates_plot
    params:
        outdir=output_dir,
        output_name="rates.png",
    shell:
        """
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """

rule compute_embeddings:
    input:
        rates=rates_data,
        script="../../utils/compute_embeddings.py",
        main_script=COMPUTE_EMBEDDINGS_SCRIPT
    output:
        embeddings_data
    params:
        outdir=output_dir,
        output_name="embeddings.parquet"
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """

rule plot_embeddings_sim:
    input:
        embeddings=embeddings_data,
        pop_colors=pop_colors,
        pop_labels=pop_labels,
        script="../../utils/plot_embeddings.py",
        main_script=PLOT_EMBEDDINGS_SCRIPT
    output:
        embeddings_3d_plot
    params:
        outdir=output_dir,
        output_name="embeddings.html",
        min_time=min_time
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.embeddings} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --min_time {params.min_time}
        """

