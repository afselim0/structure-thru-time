# 3. Performance Evaluation
rule evaluate_performance_true:
    input:
        embeddings=EMBEDDINGS_TRUE,
        rates=RATES_TRUE,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="../../utils/evaluate_performance.py",
    output:
        PERFORMANCE_TRUE,
        PERFORMANCE_TRUE_PLOT
    params:
        N0=N0,
        data_output_path=DATA_OUTPUT_PATH,
        plot_output_path=PLOT_OUTPUT_PATH,
        data_output_name=PERFORMANCE_TRUE_FILE,
        plot_output_name=PERFORMANCE_TRUE_PLOT_FILE
    shell:
        """
        python {input.script} \
            --embeddings {input.embeddings} \
            --rates {input.rates} \
            --N0 {params.N0} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --data_output_path {params.data_output_path} \
            --plot_output_path {params.plot_output_path} \
            --data_output_name {params.data_output_name} \
            --plot_output_name {params.plot_output_name}
        """

rule evaluate_performance_sim:
    input:
        embeddings=EMBEDDINGS_SIM,
        rates=RATES_SIM,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="../../utils/evaluate_performance.py",
    output:
        PERFORMANCE_SIM,
        PERFORMANCE_SIM_PLOT
    params:
        N0=N0,
        data_output_path=DATA_OUTPUT_PATH,
        plot_output_path=PLOT_OUTPUT_PATH,
        data_output_name=PERFORMANCE_SIM_FILE,
        plot_output_name=PERFORMANCE_SIM_PLOT_FILE
    shell:
        """
        python {input.script} \
            --embeddings {input.embeddings} \
            --rates {input.rates} \
            --N0 {params.N0} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --data_output_path {params.data_output_path} \
            --plot_output_path {params.plot_output_path} \
            --data_output_name {params.data_output_name} \
            --plot_output_name {params.plot_output_name}
        """

rule evaluate_performance_infer:
    input:
        embeddings=EMBEDDINGS_INFER,
        rates=RATES_INFER,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="../../utils/evaluate_performance.py",
    output:
        PERFORMANCE_INFER,
        PERFORMANCE_INFER_PLOT
    params:
        N0=N0,
        data_output_path=DATA_OUTPUT_PATH,
        plot_output_path=PLOT_OUTPUT_PATH,
        data_output_name=PERFORMANCE_INFER_FILE,
        plot_output_name=PERFORMANCE_INFER_PLOT_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --embeddings {input.embeddings} \
            --rates {input.rates} \
            --N0 {params.N0} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --data_output_path {params.data_output_path} \
            --plot_output_path {params.plot_output_path} \
            --data_output_name {params.data_output_name} \
            --plot_output_name {params.plot_output_name}
        """