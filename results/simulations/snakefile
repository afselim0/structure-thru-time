import os
import demes
import msprime

DEME_FILE_PATH = config["demes_file_path"] # Only strictly required input

# Parse Simulated Deme
DEME_NAME = os.path.splitext(os.path.basename(DEME_FILE_PATH))[0]
graph = demes.load(DEME_FILE_PATH)
demography = msprime.Demography.from_demes(graph)
n_pops = demography.num_populations

# Parameters
## Simulation Parameters
NUM_CONTIGS = config["num_contigs"] if "num_contigs" in config else 100
NUM_REPLICATES = config["num_replicates"] if "num_replicates" in config else 1
CONTIG_LENGTH = config["contig_length"] if "contig_length" in config else 3000000
N_PER_POP = config["n_per_pop"] if "n_per_pop" in config else 10
INFER_METHOD = config["infer_method"] if "infer_method" in config else "tsinfer"

## STT Parameters
FRACTION_PAIRS = config["fraction_pairs"] if "fraction_pairs" in config else 1
WINDOW_SIZE = config["window_size"] if "window_size" in config else 100
N0 = config["N0"] if "N0" in config else 1
MIN_TIME = config["min_time"] if "min_time" in config else 1
MAX_TIME = config["max_time"] if "max_time" in config else int(2*demography.events[-1].time)
N_TIMEPOINTS = config["n_timepoints"] if "n_timepoints" in config else 1000
VERSION = "1"

# Main Script Paths
CountCoalEvents_SCRIPT = "../../src/CountCoalEvents.py"
COMPUTE_RATES_SCRIPT = "../../src/compute_coal_rates.py"
COMPUTE_EMBEDDINGS_SCRIPT = "../../src/LatentSpaceEmbeddings.py"
PLOT_EMBEDDINGS_SCRIPT = "../../src/PlotEmbeddings.py"

# Base output directory
OUTPUT_PATH = f"outputs/{DEME_NAME}"
DATA_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"data")
PLOT_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"plots")
SIM_TREE_OUTPUT_PATH = os.path.join(OUTPUT_PATH,f"trees/sim")
INFER_TREE_OUTPUT_PATH = os.path.join(OUTPUT_PATH,f"trees/{INFER_METHOD}")

# Tags
SIM_TAG = f".V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}"
INFER_TAG = SIM_TAG + f".m{INFER_METHOD}"

RATES_TAG = f".WS{WINDOW_SIZE}.T{MIN_TIME}_{MAX_TIME}_{N_TIMEPOINTS}"
EMBEDDINGS_TAG = RATES_TAG + f".N0{N0}"

# PDF_SIM_TAG = f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}"
# PDF_INFER_TAG = f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}.m{INFER_METHOD}"
# RATES_SIM_TAG = f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}.T{MIN_TIME}_{MAX_TIME}_{N_TIMEPOINTS}"
# RATES_INFER_TAG =f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}.T{MIN_TIME}_{MAX_TIME}_{N_TIMEPOINTS}.m{INFER_METHOD}"
# EMBEDDINGS_SIM_TAG = f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}.N0{N0}"
# EMBEDDINGS_INFER_TAG = f"V{VERSION}.NPP{N_PER_POP}.NC{NUM_CONTIGS}.FP{FRACTION_PAIRS}.WS{WINDOW_SIZE}.N0{N0}.m{INFER_METHOD}"


# File Names
POP_COLORS_FILE          = "pop_colors.csv"
POP_LABELS_FILE          = "pop_labels.csv"

PDF_TRUE_FILE            = f"pdf_true.parquet"
PDF_SIM_FILE             = f"pdf_sim{SIM_TAG}.parquet"
PDF_INFER_FILE           = f"pdf_infer{INFER_TAG}.parquet"

RATES_TRUE_FILE          = f"rates_true.parquet"
RATES_SIM_FILE           = f"rates_sim{SIM_TAG + RATES_TAG}.parquet"
RATES_INFER_FILE         = f"rates_infer{INFER_TAG + RATES_TAG}.parquet"

EMBEDDINGS_TRUE_FILE     = f"embeddings_true.N0{N0}.parquet"
EMBEDDINGS_SIM_FILE      = f"embeddings_sim{SIM_TAG + EMBEDDINGS_TAG}.parquet"
EMBEDDINGS_INFER_FILE    = f"embeddings_infer{INFER_TAG + EMBEDDINGS_TAG}.parquet"

SIM_FINISHED_FILE        = f"finished_sim{SIM_TAG}.txt"
INFER_FINISHED_FILE      = f"finished_infer{INFER_TAG}.txt"

PCA_PLOT_FILE            = f"pca.png"
RATES_TRUE_PLOT_FILE     = f"rates_true.png"
RATES_SIM_PLOT_FILE      = f"rates_sim.{SIM_TAG + RATES_TAG}.png"
RATES_INFER_PLOT_FILE    = f"rates_infer.{INFER_TAG + RATES_TAG}.png"

EMB_TRUE_PLOT_FILE       = f"embeddings_true.N0{N0}.html"
EMB_SIM_PLOT_FILE        = f"embeddings_sim{SIM_TAG + EMBEDDINGS_TAG}.html"
EMB_INFER_PLOT_FILE      = f"embeddings_infer{INFER_TAG + EMBEDDINGS_TAG}.html"

PERFORMANCE_TRUE_FILE    = f"performance_true.N0{N0}.parquet"
PERFORMANCE_SIM_FILE     = f"performance_sim{SIM_TAG + EMBEDDINGS_TAG}.parquet"
PERFORMANCE_INFER_FILE   = f"performance_infer{INFER_TAG + EMBEDDINGS_TAG}.parquet"

PERFORMANCE_TRUE_PLOT_FILE    = f"performance_true.N0{N0}.png"
PERFORMANCE_SIM_PLOT_FILE     = f"performance_sim{SIM_TAG + EMBEDDINGS_TAG}.png"
PERFORMANCE_INFER_PLOT_FILE   = f"performance_infer{INFER_TAG + EMBEDDINGS_TAG}.png"

DEMOGRAPHY_PLOT_FILE     = "demography.png"

# Data outputs and basic plot outputs
POP_COLORS          = os.path.join(DATA_OUTPUT_PATH, POP_COLORS_FILE)
POP_LABELS          = os.path.join(DATA_OUTPUT_PATH, POP_LABELS_FILE)
DEMOGRAPHY_PLOT     = os.path.join(PLOT_OUTPUT_PATH, DEMOGRAPHY_PLOT_FILE)
PCA_PLOT            = os.path.join(PLOT_OUTPUT_PATH, PCA_PLOT_FILE)

# Tree outputs
SIM_FINISHED        = os.path.join(SIM_TREE_OUTPUT_PATH, SIM_FINISHED_FILE)
INFER_FINISHED      = os.path.join(INFER_TREE_OUTPUT_PATH, INFER_FINISHED_FILE)

# STT outputs
RATES_TRUE               = os.path.join(DATA_OUTPUT_PATH, RATES_TRUE_FILE)

PDF_SIM                  = os.path.join(DATA_OUTPUT_PATH, PDF_SIM_FILE)
RATES_SIM                = os.path.join(DATA_OUTPUT_PATH, RATES_SIM_FILE)
PDF_INFER                = os.path.join(DATA_OUTPUT_PATH, PDF_INFER_FILE)
RATES_INFER              = os.path.join(DATA_OUTPUT_PATH, RATES_INFER_FILE)

EMBEDDINGS_TRUE          = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_TRUE_FILE)
EMBEDDINGS_SIM           = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_SIM_FILE)
EMBEDDINGS_INFER         = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_INFER_FILE)

RATES_TRUE_PLOT          = os.path.join(PLOT_OUTPUT_PATH, RATES_TRUE_PLOT_FILE)
RATES_SIM_PLOT           = os.path.join(PLOT_OUTPUT_PATH, RATES_SIM_PLOT_FILE)
RATES_INFER_PLOT         = os.path.join(PLOT_OUTPUT_PATH, RATES_INFER_PLOT_FILE)

EMB_TRUE_PLOT            = os.path.join(PLOT_OUTPUT_PATH, EMB_TRUE_PLOT_FILE)
EMB_SIM_PLOT             = os.path.join(PLOT_OUTPUT_PATH, EMB_SIM_PLOT_FILE)
EMB_INFER_PLOT           = os.path.join(PLOT_OUTPUT_PATH, EMB_INFER_PLOT_FILE)

PERFORMANCE_TRUE         = os.path.join(DATA_OUTPUT_PATH, PERFORMANCE_TRUE_FILE)
PERFORMANCE_SIM          = os.path.join(DATA_OUTPUT_PATH, PERFORMANCE_SIM_FILE)
PERFORMANCE_INFER        = os.path.join(DATA_OUTPUT_PATH, PERFORMANCE_INFER_FILE)

PERFORMANCE_TRUE_PLOT    = os.path.join(PLOT_OUTPUT_PATH, PERFORMANCE_TRUE_PLOT_FILE)
PERFORMANCE_SIM_PLOT     = os.path.join(PLOT_OUTPUT_PATH, PERFORMANCE_SIM_PLOT_FILE)
PERFORMANCE_INFER_PLOT   = os.path.join(PLOT_OUTPUT_PATH, PERFORMANCE_INFER_PLOT_FILE)

## Remove file extensions and add them in scripts
## Add performance plots

BASE_TARGETS = [
    POP_COLORS,
    POP_LABELS,
    PCA_PLOT,
    SIM_FINISHED,
    RATES_SIM,
    EMBEDDINGS_SIM,
    EMB_SIM_PLOT,
    PERFORMANCE_TRUE,
    PERFORMANCE_SIM,
    PERFORMANCE_SIM_PLOT
]

INFER_TARGETS = [
    INFER_FINISHED,
    RATES_INFER_PLOT,
    EMBEDDINGS_INFER,
    EMB_INFER_PLOT,
    PERFORMANCE_INFER
]

if n_pops<20:
    BASE_TARGETS.append(DEMOGRAPHY_PLOT)
    BASE_TARGETS.append(RATES_TRUE)
    BASE_TARGETS.append(RATES_TRUE_PLOT)
    BASE_TARGETS.append(RATES_SIM_PLOT)
    BASE_TARGETS.append(EMBEDDINGS_TRUE)
    BASE_TARGETS.append(EMB_TRUE_PLOT)
    INFER_TARGETS.append(RATES_INFER_PLOT)
    BASE_TARGETS.append(PERFORMANCE_TRUE_PLOT)
    INFER_TARGETS.append(PERFORMANCE_INFER_PLOT)
    
rule all:
    input:
        BASE_TARGETS, INFER_TARGETS

rule sim:
    input:
        BASE_TARGETS

# --------------------Preprocessing--------------------
rule preprocess_data:
    input:
        demes_file_path=DEME_FILE_PATH,
        script="../../utils/preprocess_demography.py"
    output:
        POP_COLORS,
        POP_LABELS
    params:
        outdir=DATA_OUTPUT_PATH,
        n_per_pop=N_PER_POP
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """

rule plot_demography:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_colors=POP_COLORS,
        script="../../utils/plot_demography.py"
    output:
        DEMOGRAPHY_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        max_time=MAX_TIME
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --output_path {params.outdir} \
            --max_time {params.max_time}
        """

rule run_pca:
    input:
        pop_colors = POP_COLORS,
        pop_labels = POP_LABELS,
        demes_file_path=DEME_FILE_PATH,
        script = "../../utils/run_pca.py"
    output:
        PCA_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        n_per_pop=N_PER_POP
    shell:
        """
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """

# --------------------Generating Trees--------------------
rule simulate_trees:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_labels=POP_LABELS,
        script="../../utils/simulate_trees.py"
    output:
        SIM_FINISHED
    params:
        outdir=SIM_TREE_OUTPUT_PATH,
        num_contigs=NUM_CONTIGS,
        num_replicates=NUM_REPLICATES,
        contig_length=CONTIG_LENGTH,
        sim_params=SIM_FINISHED_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --labels {input.pop_labels} \
            --num_contigs {params.num_contigs} \
            --num_replicates {params.num_replicates} \
            --contig_length {params.contig_length} \
            --sim_params {params.sim_params}

        """

rule infer_trees:
    input:
        sim_finished=SIM_FINISHED,
        script="../../utils/infer_trees.py"
    output:
        INFER_FINISHED
    params:
        sim_tree_dir=SIM_TREE_OUTPUT_PATH,
        outdir=INFER_TREE_OUTPUT_PATH
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --sim_tree_path {params.sim_tree_dir} \
            --output_path {params.outdir}
        """

# --------------------Coalescent Rates--------------------
# 1. Compute
rule compute_rates_true:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_labels = POP_LABELS,
        script="../../utils/compute_rates_true.py"
    output:
        RATES_TRUE
    params:
        outdir=DATA_OUTPUT_PATH,
        max_time=MAX_TIME
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --max_time {params.max_time} \
            --labels {input.pop_labels}
        """

rule compute_pdf_sim:
    input:
        sim_finished=SIM_FINISHED,
        script="../../utils/compute_pdf.py",
        main_script=CountCoalEvents_SCRIPT
    output:
        PDF_SIM
    params:
        tree_dir=SIM_TREE_OUTPUT_PATH,
        outdir=DATA_OUTPUT_PATH,
        output_name=PDF_SIM_FILE,
        max_time=MAX_TIME,
        n_timepoints=N_TIMEPOINTS,
        num_posterior_samples=NUM_REPLICATES,
        fraction_pairs=FRACTION_PAIRS,
        pop_labels=POP_LABELS
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.tree_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
            --num_posterior_samples {params.num_posterior_samples} \
            --fraction_pairs {params.fraction_pairs} \
            --pop_labels {params.pop_labels}
        """

rule compute_rates_sim:
    input:
        pdf_sim=PDF_SIM,
        script="../../utils/compute_rates.py",
        main_script=COMPUTE_RATES_SCRIPT
    output:
        RATES_SIM
    params:
        outdir=DATA_OUTPUT_PATH,
        output_name=RATES_SIM_FILE,
        window_size=WINDOW_SIZE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_sim} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --window_size {params.window_size} 
        """

rule compute_pdf_infer:
    input:
        infer_finished=INFER_FINISHED,
        script="../../utils/compute_pdf.py",
        main_script=CountCoalEvents_SCRIPT
    output:
        PDF_INFER
    params:
        tree_dir=INFER_TREE_OUTPUT_PATH,
        outdir=DATA_OUTPUT_PATH,
        output_name=PDF_INFER_FILE,
        max_time=MAX_TIME,
        n_timepoints=N_TIMEPOINTS,
        num_posterior_samples=NUM_REPLICATES,
        fraction_pairs=FRACTION_PAIRS,
        pop_labels=POP_LABELS
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.tree_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
            --num_posterior_samples {params.num_posterior_samples} \
            --fraction_pairs {params.fraction_pairs} \
            --pop_labels {params.pop_labels}
        """

rule compute_rates_infer:
    input:
        pdf_infer=PDF_INFER,
        script="../../utils/compute_rates.py",
        main_script=COMPUTE_RATES_SCRIPT
    output:
        RATES_INFER
    params:
        outdir=DATA_OUTPUT_PATH,
        output_name=RATES_INFER_FILE,
        window_size=WINDOW_SIZE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_infer} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --window_size {params.window_size} \
        """

