import os
import demes
import msprime

# Parse Simulated Deme
DEME_FILE_PATH = config["demes_file_path"]
DEME_NAME = os.path.splitext(os.path.basename(DEME_FILE_PATH))[0]
graph = demes.load(DEME_FILE_PATH)
demography = msprime.Demography.from_demes(graph)

# Fixed Params
if "SS" not in DEME_NAME:
    MAX_TIME = int(2*demography.events[-1].time)
else:
    MAX_TIME = 50000
WINDOW_SIZE = 100
N_TIMEPOINTS = 100
N_PER_POP=20

# Base output directory
OUTPUT_PATH = f"../outputs/{DEME_NAME}"
DATA_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"data")
PLOT_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"plots")
SIM_TREE_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"trees/sim")
INFER_TREE_OUTPUT_PATH = os.path.join(OUTPUT_PATH,"trees/infer")

# Main Script Paths
INFER_RATES_SCRIPT = "../../../src/CountCoalEvents.py"
COMPUTE_EMBEDDINGS_SCRIPT = "../../../src/LatentSpaceEmbeddings.py"
PLOT_EMBEDDINGS_SCRIPT = "../../../src/PlotEmbeddings.py"

# File Names
POP_COLORS_FILE          = "pop_colors.parquet"
POP_LABELS_FILE          = "pop_labels.parquet"

RATES_TRUE_FILE          = "rates_true.parquet"
RATES_SIM_FILE           = "rates_sim.parquet"
RATES_INFER_FILE         = "rates_infer.parquet"

EMBEDDINGS_TRUE_FILE     = "embeddings_true.parquet"
EMBEDDINGS_SIM_FILE      = "embeddings_sim.parquet"
EMBEDDINGS_INFER_FILE    = "embeddings_infer.parquet"

SIM_FINISHED_FILE        = "finished_sim.txt"
INFER_FINISHED_FILE      = "finished_infer.txt"

PCA_PLOT_FILE            = "pca.png"
RATES_TRUE_PLOT_FILE     = "rates_true.png"
RATES_SIM_PLOT_FILE      = "rates_sim.png"
RATES_INFER_PLOT_FILE    = "rates_infer.png"

EMB_TRUE_PLOT_FILE       = "embeddings_true.html"
EMB_SIM_PLOT_FILE        = "embeddings_sim.html"
EMB_INFER_PLOT_FILE      = "embeddings_infer.html"

DEMOGRAPHY_PLOT_FILE     = "demography.png"


# Data outputs
POP_COLORS          = os.path.join(DATA_OUTPUT_PATH, POP_COLORS_FILE)
POP_LABELS          = os.path.join(DATA_OUTPUT_PATH, POP_LABELS_FILE)

RATES_TRUE          = os.path.join(DATA_OUTPUT_PATH, RATES_TRUE_FILE)
RATES_SIM           = os.path.join(DATA_OUTPUT_PATH, RATES_SIM_FILE)
RATES_INFER         = os.path.join(DATA_OUTPUT_PATH, RATES_INFER_FILE)

EMBEDDINGS_TRUE     = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_TRUE_FILE)
EMBEDDINGS_SIM      = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_SIM_FILE)
EMBEDDINGS_INFER    = os.path.join(DATA_OUTPUT_PATH, EMBEDDINGS_INFER_FILE)

# Tree outputs
SIM_FINISHED        = os.path.join(SIM_TREE_OUTPUT_PATH, SIM_FINISHED_FILE)
INFER_FINISHED      = os.path.join(INFER_TREE_OUTPUT_PATH, INFER_FINISHED_FILE)

# Plot outputs
PCA_PLOT            = os.path.join(PLOT_OUTPUT_PATH, PCA_PLOT_FILE)
RATES_TRUE_PLOT     = os.path.join(PLOT_OUTPUT_PATH, RATES_TRUE_PLOT_FILE)
RATES_SIM_PLOT      = os.path.join(PLOT_OUTPUT_PATH, RATES_SIM_PLOT_FILE)
RATES_INFER_PLOT    = os.path.join(PLOT_OUTPUT_PATH, RATES_INFER_PLOT_FILE)

EMB_TRUE_PLOT       = os.path.join(PLOT_OUTPUT_PATH, EMB_TRUE_PLOT_FILE)
EMB_SIM_PLOT        = os.path.join(PLOT_OUTPUT_PATH, EMB_SIM_PLOT_FILE)
EMB_INFER_PLOT      = os.path.join(PLOT_OUTPUT_PATH, EMB_INFER_PLOT_FILE)

DEMOGRAPHY_PLOT     = os.path.join(PLOT_OUTPUT_PATH, DEMOGRAPHY_PLOT_FILE)


BASE_TARGETS = [
    POP_COLORS,
    POP_LABELS,
    PCA_PLOT,
    SIM_FINISHED,
    RATES_SIM,
    EMBEDDINGS_SIM,
    EMB_SIM_PLOT,
    INFER_FINISHED,
    RATES_INFER,
    EMBEDDINGS_INFER,
    EMB_INFER_PLOT,
]

if "SS" not in DEME_NAME:
    BASE_TARGETS.append(DEMOGRAPHY_PLOT)
    BASE_TARGETS.append(RATES_TRUE)
    BASE_TARGETS.append(RATES_TRUE_PLOT)
    BASE_TARGETS.append(RATES_SIM_PLOT)
    BASE_TARGETS.append(EMBEDDINGS_TRUE)
    BASE_TARGETS.append(EMB_TRUE_PLOT)
    BASE_TARGETS.append(RATES_INFER_PLOT)
    
    
rule all:
    input:
        BASE_TARGETS

# Preprocessing
rule preprocess_data:
    input:
        demes_file_path=DEME_FILE_PATH,
        script="preprocess_demography.py"
    output:
        POP_COLORS,
        POP_LABELS
    params:
        outdir=DATA_OUTPUT_PATH,
        n_per_pop=N_PER_POP
    shell:
        """
        mkdir -p {params.outdir}
        python preprocess_demography.py \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """

rule plot_demography:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_colors=POP_COLORS,
        script="plot_demography.py"
    output:
        DEMOGRAPHY_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        max_time=MAX_TIME
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --output_path {params.outdir} \
            --max_time {params.max_time}
        """

rule run_pca:
    input:
        pop_colors = POP_COLORS,
        pop_labels = POP_LABELS,
        demes_file_path=DEME_FILE_PATH,
        script = "run_pca.py"
    output:
        PCA_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        n_per_pop=N_PER_POP
    shell:
        """
        python run_pca.py \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """

# Trees
rule simulate_trees:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_labels=POP_LABELS,
        script="simulate_trees.py"
    output:
        SIM_FINISHED
    params:
        outdir=SIM_TREE_OUTPUT_PATH,
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --labels {input.pop_labels}
        """

rule infer_trees:
    input:
        sim_finished=SIM_FINISHED,
        script="infer_trees.py"
    output:
        INFER_FINISHED
    params:
        sim_tree_dir=SIM_TREE_OUTPUT_PATH,
        outdir=INFER_TREE_OUTPUT_PATH
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --sim_tree_path {params.sim_tree_dir} \
            --output_path {params.outdir}
        """

# Rates
## Compute
rule compute_rates_true:
    input:
        demes_file_path=DEME_FILE_PATH,
        pop_labels = POP_LABELS,
        script="compute_rates_true.py"
    output:
        RATES_TRUE
    params:
        outdir=DATA_OUTPUT_PATH,
        max_time=MAX_TIME
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --max_time {params.max_time} \
            --labels {input.pop_labels}
        """

rule compute_rates_sim:
    input:
        sim_finished=SIM_FINISHED,
        script="compute_rates.py",
        main_script=INFER_RATES_SCRIPT
    output:
        RATES_SIM
    params:
        tree_dir=SIM_TREE_OUTPUT_PATH,
        outdir=DATA_OUTPUT_PATH,
        max_time=MAX_TIME,
        window_size=WINDOW_SIZE,
        output_name=RATES_SIM_FILE,
        n_timepoints=N_TIMEPOINTS
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.tree_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --window_size {params.window_size} \
            --n_timepoints {params.n_timepoints}
        """

rule compute_rates_infer:
    input:
        infer_finished=INFER_FINISHED,
        script="compute_rates.py",
        main_script=INFER_RATES_SCRIPT
    output:
        RATES_INFER
    params:
        tree_dir=INFER_TREE_OUTPUT_PATH,
        outdir=DATA_OUTPUT_PATH,
        max_time=MAX_TIME,
        window_size=WINDOW_SIZE,
        output_name=RATES_INFER_FILE,
        n_timepoints=N_TIMEPOINTS
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.tree_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --window_size {params.window_size} \
            --n_timepoints {params.n_timepoints}
        """

## Plot
rule plot_rates_true:
    input:
        rates=RATES_TRUE,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="plot_rates.py"
    output:
        RATES_TRUE_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        output_name=RATES_TRUE_PLOT_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """

rule plot_rates_sim:
    input:
        rates=RATES_SIM,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="plot_rates.py"
    output:
        RATES_SIM_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        output_name=RATES_SIM_PLOT_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """

rule plot_rates_infer:
    input:
        rates=RATES_INFER,
        pop_colors=POP_COLORS,
        pop_labels=POP_LABELS,
        script="plot_rates.py"
    output:
        RATES_INFER_PLOT
    params:
        outdir=PLOT_OUTPUT_PATH,
        output_name=RATES_INFER_PLOT_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """

# Embeddings
## Compute
