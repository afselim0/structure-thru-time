def dynamic_3d_plot(embeddings_df, output ,colors_dict,log_time=True):
    fig = px.line_3d(embeddings_df, x="X1", y="X2", z="time",log_z=log_time, color='population',line_group='sample_id',
        color_discrete_map=colors_dict
    )
    fig.update_layout(showlegend=True)
    # fig.show()
    pio.write_html(fig, file=os.path.join(output,"dynamic_3d_plot.html"))

    return fig

def static_3d_plot(embeddings_df, output, colors_dict,log_time=True):
    fig = go.Figure()
    sample_ids = np.unique(embeddings_df.sample_id.values)

    for sample_id in sample_ids:
        df_subset = embeddings_df[embeddings_df["sample_id"] == sample_id]
        fig.add_trace(go.Scatter3d(
            x=df_subset["X1"],
            y=df_subset["X2"],
            z=df_subset["time"],
            mode='lines',
            line=dict(width=0.5, color=colors_dict[df_subset["population"].values[0]]),
            name=f"Sample {sample_id}",
            opacity= 1
        ))

    # Get combined min/max from X1 and X2 columns
    xy_min = min(embeddings_df["X1"].min(), embeddings_df["X2"].min())
    xy_max = max(embeddings_df["X1"].max(), embeddings_df["X2"].max())

    # Add 10% padding for margins
    padding = 0.1 * (xy_max - xy_min)
    xy_range = [xy_min - padding, xy_max + padding]
    
    fig.update_layout(showlegend=False,
        margin=dict(l=0, r=0, t=0, b=0),
        scene=dict(
            xaxis_title='X1',
            yaxis_title='X2',
            zaxis_title='Time (generations ago)'
        )
    )

    if log_time:
        fig.update_layout(scene=dict(zaxis_type="log"))

    fig.update_layout(
        scene=dict(
            xaxis=dict(range=xy_range),  # Same range for X
            yaxis=dict(range=xy_range),  # Same range for Y
            aspectmode='manual',  # Prevents auto-scaling
            aspectratio=dict(x=1, y=1, z=0.7),  # X/Y equal, Z scaled down
        )
    )

    fig.update_layout(
        width=600,
        height=600,
        scene_camera=dict(
            eye=dict(x=2, y=2, z=1),  # Diagonal view
        )
    )

    fig.write_image(os.path.join(output,"static_3d_plot.png"), scale=3)
    
    return fig

def main():
    # default parameters
    delta = 100
    min_time = 10
    
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", type=str, required=True, help="path to directory with inferred trees")    
    parser.add_argument("--output", type=str, required=True, help="output path")
    parser.add_argument("--metadata", type=str, required = False, help="path to metadata file. Must include columns with names [population,sample_id]")
    parser.add_argument("--min_time", default=10, type=float, help="minimum time to start computing rates and embeddings")
    parser.add_argument("--max_time", type=float, help="maximum time to compute rates and embeddings")
    parser.add_argument("--num_timepoints", type=int, default=100, help="number of timepoints to use")
    parser.add_argument("--delta", default = 100, type=float, help="the time width of each window")
    parser.add_argument("--no_log_time", action="store_true", help="use this flag to have linear-spaced time points")

    args = parser.parse_args()
    
    input = args.input
    output_path = args.output
    metadata_path = args.metadata
    min_time = args.min_time
    max_time = args.max_time
    num_timepoints = args.num_timepoints
    delta = args.delta
    log_time = not args.no_log_time

    os.makedirs(output_path,exist_ok=True)

    if log_time:
        times = np.logspace(np.log10(min_time),np.log10(max_time),num_timepoints)
    else:
        times = np.linspace(min_time,max_time,num_timepoints)
    
    # Loading files
    metadata = pd.read_csv(metadata_path)
    if "sample_times" not in metadata.columns:
        metadata["sample_times"] = 0

    population_samples_dict = defaultdict(list)
    for row in metadata.iterrows():
        population_samples_dict[row[1]["population"]].append(row[1]["sample_id"])
    extant_populations = np.unique(metadata["population"])
    K = len(extant_populations)

    # extant_populations = np.unique(metadata["population"])
    # K = len(extant_populations)
    # population_samples_dict = {}
    # for pop in extant_populations:
    #     population_samples_dict[pop] = metadata[metadata["population"]==pop]["sample_id"].values

    # cmap = plt.get_cmap("rainbow")
    # colors = cmap(np.linspace(0,255,K).astype(int))[:,:-1]
    # colors_dict = {label:mcolors.to_hex(colors[i]) for i,label in enumerate(extant_populations)}

    # Compute the number of coalescent events and uncoalesced lineages through time
    ts_files = glob.glob(os.path.join(input,"*.trees"))
    trees = itertools.chain.from_iterable((tskit.load(ts_file).trees() for ts_file in ts_files))
    N, L = count_coal_events(trees, times, delta)
    # embeddings_through_time = compute_embeddings_through_time(N,L,times,delta,sample_times=metadata["sample_times"].values)
    embeddings_through_time = compute_embeddings_through_time(N,L)

    # Saving data
    counts_df = create_counts_df(N, L, times, population_samples_dict)
    embeddings_df = create_embeddings_df(embeddings_through_time, times, population_samples_dict)

    counts_df.to_parquet(os.path.join(output_path,"counts.parquet"))
    embeddings_df.to_parquet(os.path.join(output_path,"embeddings.parquet"))
    metadata.to_parquet(os.path.join(output_path,"metadata.parquet"))

    # Plotting demography
    if "hex_colour" in metadata.columns:
        colors_dict = {}
        for row in metadata[["population","hex_colour"]].drop_duplicates().iterrows():
            colors_dict[row[1]["population"]] = row[1]["hex_colour"]
    else:
        cmap = plt.get_cmap("rainbow")
        colors = cmap(np.linspace(0,255,K).astype(int))[:,:-1]
        colors_dict = {label:mcolors.to_hex(colors[i]) for i,label in enumerate(extant_populations)}

    dynamic_fig = dynamic_3d_plot(embeddings_df,output_path,colors_dict,log_time)
    static_fig = static_3d_plot(embeddings_df,output_path,colors_dict,log_time)

# %%
if __name__ == "__main__":
    main()
