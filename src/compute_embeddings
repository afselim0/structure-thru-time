#!/usr/bin/env python3
#%%
from plot_params import *
import os
import glob
import numpy as np # type: ignore
import pandas as pd
import itertools
import tskit
import argparse
import matplotlib.colors as mcolors
import plotly.express as px
import plotly.io as pio
from counting import *
from latent_embeddings import *

def dynamic_3d_plot(embeddings_df, output ,colors_dict):
    fig = px.line_3d(embeddings_df, x="X1", y="X2", z="time",log_z=True, color='population',line_group='sample_id',
        color_discrete_map=colors_dict
    )
    fig.update_layout(showlegend=True)
    # fig.show()
    pio.write_html(fig, file=os.path.join(output,"dynamic_3d_plot.html"))

    return fig

def main():
    # default parameters
    delta = 100
    min_time = 10
    
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", type=str, required=True, help="path to directory with inferred trees")    
    parser.add_argument("--output", type=str, required=True, help="output path")
    parser.add_argument("--metadata", type=str, required = False, help="path to metadata file. Must include columns with names [population,sample_id]")
    parser.add_argument("--min_time", type=float, help="minimum time to start computing rates and embeddings")
    parser.add_argument("--max_time", type=float, help="maximum time to compute rates and embeddings")
    parser.add_argument("--num_timepoints", type=int, default=100, help="number of timepoints to use")
    parser.add_argument("--delta", type=float, help="the time width of each window")
    parser.add_argument("--log_time", action="store_true", help="use this flag to have log-spaced time points")

    args = parser.parse_args()
    
    input = args.input
    output_path = args.output
    metadata_path = args.metadata
    min_time = args.min_time
    max_time = args.max_time
    num_timepoints = args.num_timepoints
    delta = args.delta
    log_time = args.log_time

    os.makedirs(output_path,exist_ok=True)

    if log_time:
        times = np.logspace(np.log10(min_time),np.log10(max_time),num_timepoints)
    else:
        times = np.linspace(min_time,max_time,num_timepoints)
    
    # Loading files
    metadata = pd.read_csv(metadata_path)
    if "sample_times" not in metadata.columns:
        metadata["sample_times"] = 0

    extant_populations = np.unique(metadata["population"])
    K = len(extant_populations)
    population_samples_dict = {}
    for pop in extant_populations:
        population_samples_dict[pop] = metadata[metadata["population"]==pop]["sample_id"].values

    cmap = plt.get_cmap("rainbow")
    colors = cmap(np.linspace(0,255,K).astype(int))[:,:-1]
    colors_dict = {label:mcolors.to_hex(colors[i]) for i,label in enumerate(extant_populations)}

    # Compute the number of coalescent events and uncoalesced lineages through time
    ts_files = glob.glob(os.path.join(input,"*.trees"))
    trees = itertools.chain.from_iterable((tskit.load(ts_file).trees() for ts_file in ts_files))
    N, L = count_coal_events(trees, times, delta)
    embeddings_through_time = compute_embeddings_through_time(N,L,times,sample_times=metadata["sample_times"].values)

    # Saving data
    counts_df = create_counts_df(N, L, times, population_samples_dict)
    embeddings_df = create_embeddings_df(embeddings_through_time, times, population_samples_dict)

    counts_df.to_parquet(os.path.join(output_path,"counts.parquet"))
    embeddings_df.to_parquet(os.path.join(output_path,"embeddings.parquet"))
    metadata.to_parquet(os.path.join(output_path,"metadata.parquet"))

    # Plotting demography
    if "hex_colour" in metadata.columns:
        colors_dict = {}
        for row in metadata[["population","hex_colour"]].drop_duplicates().iterrows():
            colors_dict[row[1]["population"]] = row[1]["hex_colour"]
    else:
        cmap = plt.get_cmap("rainbow")
        colors = cmap(np.linspace(0,255,K).astype(int))[:,:-1]
        colors_dict = {label:mcolors.to_hex(colors[i]) for i,label in enumerate(extant_populations)}
        
    dynanimic_fig = dynamic_3d_plot(embeddings_df,output_path,colors_dict)

# %%
if __name__ == "__main__":
    main()