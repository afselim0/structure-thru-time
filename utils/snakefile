compute_rates_wrapper_script           = os.path.join(UTILS_DIR, "compute_rates.py")
plot_rates_script                      = os.path.join(UTILS_DIR, "plot_rates.py")
plot_relative_div_script               = os.path.join(UTILS_DIR, "plot_relative_div.py")
