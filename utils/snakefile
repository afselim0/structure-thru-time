    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --min_time {params.min_time} \
            --max_rate_plot {params.max_rate_plot} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --time_scale {params.time_scale} \
            {params.per_haplotype}
        """
rule plot_relative_div:
    input:
        rates = rates_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_relative_div_script
    output:
        relative_div_plot,
        relative_div_plot_summary
    params:
        outdir = plot_output_path,
        output_name = relative_div_plot_file_name,
        min_time = rates_min_time,
        time_scale = time_scale,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --min_time {params.min_time} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --time_scale {params.time_scale} \
            {params.per_haplotype}
        """
# Per-population effective size proxy Ne(t) = 1/(2*lambda_pop(t)), from the
# within-population pairwise rates. The aggregation over pairs happens before the
# reciprocal (see plot_effective_size.py): 1/x is convex and the rate estimator
# floors lambda at ~1e-16, so any "reciprocal first" average diverges.
rule plot_effective_size:
    input:
        rates = rates_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_effective_size_script
    output:
        effective_size_plot
    params:
        outdir = plot_output_path,
        output_name = effective_size_plot_file_name,
        min_time = rates_min_time,
        time_scale = time_scale,
        Ne_scale = Ne_plot_scale,
        max_Ne = f"--max_Ne_plot {max_Ne_plot}" if str(max_Ne_plot) != "None" else "",
        gen_time = f"--generation_time {generation_time}" if str(generation_time) != "None" else "",
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --min_time {params.min_time} \
            --time_scale {params.time_scale} \
            --Ne_scale {params.Ne_scale} \
            {params.max_Ne} {params.gen_time} {params.per_haplotype}
        """

# ______________________STT Rules_________________________
# When smoothing is on, the single compute_embeddings invocation also writes the smoothed embeddings
# + smoothed reconstructed rates (warm-started from the unsmoothed solution), so both are declared as
# outputs and the extra --smooth_* names are passed through.
rule compute_embeddings:
    input:
        rates = rates_data,
        # The weights are read by path (weights_<rates name>) rather than passed
        # as a flag, but they are declared here so a change to them refits.
        weights = weights_data,
        script = compute_embeddings_wrapper_script,
        main_script = COMPUTE_EMBEDDINGS_SCRIPT,
        support_script = OPTIMIZATION_FUNCTIONS_SCRIPT
    output:
        embeddings_data,
        reconstructed_rates,
        *( [smooth_embeddings_data, smooth_reconstructed_rates] if smoothing_on else [] )
    params:
        N_min = N_min,
        N_max = N_max,
        p = p,
        link = link,
        l1_penalties = l1_penalties,
        outdir = data_output_path,
        output_name = embeddings_data_file_name,
        reconstructed_rates_output_name = reconstructed_rates_file_name,
        n_components = n_components,
        n_timepoints_emb = n_timepoints_emb,
        pop_labels = pop_labels,
        per_haplotype = "--per-haplotype" if per_haplotype else "",
        weighted = "" if unweighted else "--weighted",
        smooth_args = (f"--smooth_output_name {smooth_embeddings_data_file_name} "
                       f"--smooth_reconstructed_rates_output_name {smooth_reconstructed_rates_file_name}"
                       if smoothing_on else "")
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --reconstructed_rates_output_name {params.reconstructed_rates_output_name} \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --p {params.p} \
            --link {params.link} \
            --l1_penalties {params.l1_penalties} \
            --n_components {params.n_components} \
            --n_timepoints_emb {params.n_timepoints_emb} \
            --pop_labels {params.pop_labels} \
            {params.per_haplotype} \
            {params.weighted} \
            {params.smooth_args}
        """
rule plot_embeddings:
    input:
        embeddings = embeddings_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_embeddings_wrapper_script,
        main_script = PLOT_EMBEDDINGS_SCRIPT
    output:
        embeddings_plot,
        dash_script = dash_launch,
    params:
        utils_abs = UTILS_DIR_ABS,
        outdir = plot_output_path,
        output_name = embeddings_plot_file_name,
        min_time = embeddings_min_time,
        embeddings_plot_lims = embeddings_plot_lims,
        embeddings_max_time = embeddings_max_time,
        time_scale = time_scale,
        N_max = N_max,
        rates_path = rates_data,
        reconstructed_rates_path = reconstructed_rates,
        per_haplotype = "--per-haplotype" if per_haplotype else "",
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.embeddings} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --lims {params.embeddings_plot_lims} \
            --min_time {params.min_time} \
            --max_time {params.embeddings_max_time} \
            --time_scale {params.time_scale} \
            {params.per_haplotype}
        cat > {output.dash_script} << 'DASHEOF'
#!/bin/bash
# Self-anchoring: the app path is absolute, so this runs from any directory.
python {params.utils_abs}/plot_embeddings_dash.py \\
    {input.embeddings} \\
    --labels {input.pop_labels} \\
    --colors {input.pop_colors} \\
    --rates {params.rates_path} \\
    --reconstructed_rates {params.reconstructed_rates_path} \\
    --N_max {params.N_max} \\
    --time_scale {params.time_scale} \\
    --min_time {params.min_time} \\
    --max_time {params.embeddings_max_time}
DASHEOF
        chmod +x {output.dash_script}
        """
