                --plot_output_path {params.plot_output_path} \
                --hist2d_output_name {params.hist2d_output_name} \
                --interactive_output_name {params.interactive_output_name} \
                {params.per_haplotype}
            """

    def ancestry_targets(wildcards):
        labels = ancestry_labels_from_checkpoint(wildcards)
        return expand(
            [
                os.path.join(ancestry_STT_path, "{label}", "data", rates_data_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", rates_plot_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", relative_div_plot_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", relative_div_plot_summary_file_name),
                os.path.join(ancestry_STT_path, "{label}", "data", embeddings_data_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", embeddings_plot_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", slice_2d_file_name),
                os.path.join(ancestry_STT_path, "{label}", "data", reconstructed_rates_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", input_vs_reconstructed_rates_plot_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", input_vs_reconstructed_rates_interactive_file_name),
                os.path.join(ancestry_STT_path, "{label}", "plots", dash_launch_file_name),
            ],
            label=labels,
        )

    rule ancestry_STT_all:
        input:
            ancestry_targets
        output:
            touch(os.path.join(output_path, "ancestry_STT_done.flag"))

