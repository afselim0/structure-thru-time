# ______________________replicate Rules______________________
rule compute_embeddings_replicate:
    input:
        rates = rates_data,
        script = compute_embeddings_wrapper_script,
        main_script = COMPUTE_EMBEDDINGS_SCRIPT,
        support_script = OPTIMIZATION_FUNCTIONS_SCRIPT
    output:
        os.path.join(data_output_path, "embeddings_seed{seed}" + STT_TAG + ".parquet")
    params:
        N_min = N_min,
        N_max = N_max,
        p = p,
        link = link,
        l1_penalties = l1_penalties,
        outdir = data_output_path,
        n_components = n_components,
        n_timepoints_emb = n_timepoints_emb,
        pop_labels = pop_labels,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name embeddings_seed{wildcards.seed}{STT_TAG}.parquet \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --p {params.p} \
            --link {params.link} \
            --l1_penalties {params.l1_penalties} \
            --n_components {params.n_components} \
            --n_timepoints_emb {params.n_timepoints_emb} \
            --pop_labels {params.pop_labels} \
            {params.per_haplotype} \
            --seed {wildcards.seed}
        """

rule plot_embeddings_replicates:
    input:
        embeddings = embeddings_replicate_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = os.path.join(UTILS_DIR, "plot_embeddings_replicates.py")
    output:
        replicates_panel
    params:
        seeds = " ".join(str(s) for s in seeds),
        outdir = plot_output_path,
        output_name = replicates_panel_file_name,
        min_time = embeddings_min_time,
        embeddings_max_time = embeddings_max_time,
        embeddings_plot_lims = embeddings_plot_lims,
        time_scale = time_scale,
        param_label = param_label,
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --inputs {input.embeddings} \
            --seeds {params.seeds} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --min_time {params.min_time} \
            --max_time {params.embeddings_max_time} \
            --lims {params.embeddings_plot_lims} \
            --time_scale {params.time_scale} \
            --param_label "{params.param_label}"
        """

rule plot_replicate_rates_comparison:
    input:
        emb_a  = os.path.join(data_output_path, "embeddings_seed{seed_a}" + STT_TAG + ".parquet"),
        emb_b  = os.path.join(data_output_path, "embeddings_seed{seed_b}" + STT_TAG + ".parquet"),
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = os.path.join(UTILS_DIR, "plot_replicate_rates_comparison.py")
    output:
        png  = os.path.join(plot_output_path, "rates_comparison_seed{seed_a}_vs_seed{seed_b}" + PLOT_TAG + ".png"),
        html = os.path.join(plot_output_path, "rates_comparison_seed{seed_a}_vs_seed{seed_b}" + PLOT_TAG + ".html"),
    params:
        outdir           = plot_output_path,
        output_name      = "rates_comparison_seed{seed_a}_vs_seed{seed_b}" + PLOT_TAG + ".png",
        output_name_html = "rates_comparison_seed{seed_a}_vs_seed{seed_b}" + PLOT_TAG + ".html",
        N_min            = N_min,
        N_max            = N_max,
        link_function    = link,
        param_label      = param_label,
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_a {input.emb_a} \
            --input_b {input.emb_b} \
            --seed_a "seed {wildcards.seed_a}" \
            --seed_b "seed {wildcards.seed_b}" \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --link_function {params.link_function} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --output_name_html {params.output_name_html} \
            --param_label "{params.param_label}"
        """

