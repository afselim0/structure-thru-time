import os
from pathlib import Path
def read_config(parameter, default, params = config):
    return config[parameter] if parameter in params else default

# =====================================================
# Input Parameters (from config)
# =====================================================

# General Parameters
output_path                       = read_config("output_path", default = "../results")
tree_output_path                  = os.path.join(output_path,"trees") # This directory is used when trees are simulated or inferred
trees_dir                         = read_config("trees_dir", default = tree_output_path) # Default is the output path of simulated/inferred trees
num_threads                       = read_config("num_threads", default = 1) # Parallelization used in simulation, inference and computation of coalescent pdf
version                           = read_config("version", default = 1)

# Simulation Parameters
demes_file_path                   = read_config("demes_file_path", default = "../data/demes/main/split.yaml")
num_contigs                       = int(read_config("num_contigs", default = 500))
contig_length                     = int(read_config("contig_length", default = 1e6))
n_sim_per_pop                     = read_config("n_sim_per_pop", default = 20)
mutation_rate                     = read_config("mutation_rate", default = 1.2e-8)
recombination_rate                = read_config("recombination_rate", default = 1.2e-8)

# Inference Parameters
infer_method                      = read_config("infer_method", default = "None")
num_posterior_samples             = read_config("num_posterior_samples", default = 1)
thinning_interval                 = read_config("thinning_interval", default = 60)
burnin                            = read_config("burnin", default = 4000)
vcf_dir                           = read_config("vcf_dir", default=tree_output_path.replace(infer_method,"sim"))

# Rate Inference Parameters
fraction_samples                  = read_config("fraction_samples", default = 1.0)   # Fraction of samples taken into account in pdf computation at each contig
min_window_size                   = read_config("min_window_size", default = 50)    # Window size for local linear regression at t=0
max_window_size                   = read_config("max_window_size", default = 500)   # Window size for local linear regression at t=max_time
max_time                          = read_config("max_time", default = 10000)
n_timepoints                      = read_config("n_timepoints", default = max_time)
phased                            = read_config("phased", default = "False") # If "False", coalescent rates (and embeddings, plots) are per-individual rather than per-haplotype

# STT Parameters 
N_min                             = read_config("N_min", default = 1)
N_max                             = read_config("N_max", default = N_min + 100000)
k                             = read_config("k", default = 1)
link                             = read_config("link", default = "inverse_distance")
l1_penalties                      = read_config("l1", default = "None") # For plotting purposes only
l2_penalties                      = read_config("l2", default = "None")# # For plotting purposes only
if isinstance(l1_penalties, list): l1_penalties = ",".join(str(x) for x in l1_penalties)
if isinstance(l2_penalties, list): l2_penalties = ",".join(str(x) for x in l2_penalties)
n_components                      = read_config("n_components", default = 2)# # For plotting purposes only
n_timepoints_emb                  = read_config("n_timepoints_emb", default = 400)
rates_time_stride                 = read_config("rates_time_stride", default = "auto") # dash bundle: thin rate-parquet timepoints ("auto"|N|1)

# Plotting parameters
min_time                          = read_config("min_time", default = 1) # For plotting purposes only
embeddings_plot_lims              = read_config("embeddings_plot_lims", default="None") 
max_rate_plot                     = read_config("max_rate_plot", default = 1/10000)
embeddings_max_time               = read_config("embeddings_max_time", default = max_time)
time_scale                        = read_config("time_scale", default = "linear")

# Empirical dataset parameters
pops                              = read_config("pops", "all").replace(","," ")
n_samples_per_pop                 = read_config("n_samples_per_pop", -1)
pop_colors                        = read_config("pop_colors", os.path.join(output_path,"data/pop_colors.csv"))
pop_labels                        = read_config("pop_labels", os.path.join(output_path,"data/pop_labels.csv"))

# Filename Tags
SIM_TAG                           = f".NC{num_contigs}.CL{contig_length}.NPP{n_sim_per_pop}"
PDF_TAG                           = f".V{version}.FS{fraction_samples}.maxT{max_time}.nT{n_timepoints}"
RATES_TAG                         = f".minWS{min_window_size}.maxWS{max_window_size}" + PDF_TAG
STT_TAG                           = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.k{k}.link{link}.L1[{l1_penalties}].L2[{l2_penalties}].nTe{n_timepoints_emb}" + RATES_TAG
PLOT_TAG                          = f".minTPlot{min_time}.maxTPlot{embeddings_max_time}.xylims{embeddings_plot_lims}" + STT_TAG
TRUE_TAG                          = f".d{n_components}.Nmin{N_min}.Nmax{N_max}" + STT_TAG

# Main scripts
COUNT_COAL_EVENTS_SCRIPT          = "../src/CountCoalEvents.py"
COMPUTE_RATES_SCRIPT              = "../src/compute_coal_rates.py"
COMPUTE_EMBEDDINGS_SCRIPT         = "../src/LatentSpaceEmbeddings.py"
OPTIMIZATION_FUNCTIONS_SCRIPT         = "../src/optimization_functions.py"
PLOT_EMBEDDINGS_SCRIPT            = "../src/PlotEmbeddings.py"
PLOT_EMBEDDINGS_PYVISTA_SCRIPT    = "../src/PlotEmbeddingsPyVista.py"

# Util Scripts
preprocess_demography_script      = "preprocess_demography.py"
plot_demography_script            = "plot_demography.py"
pca_script                        = "run_pca.py"
compute_rates_true_script         = "compute_rates_true.py"
simulate_trees_script             = "simulate_trees.py"
infer_trees_script                = "infer_trees.py"
compute_pdf_wrapper_script        = "compute_pdf.py"
compute_rates_wrapper_script      = "compute_rates.py"
plot_rates_script                 = "plot_rates.py"
compute_embeddings_wrapper_script      = "compute_embeddings.py"
plot_embeddings_wrapper_script         = "plot_embeddings.py"
plot_embeddings_pyvista_wrapper_script = "plot_embeddings_pyvista.py"
evaluate_performance_script       = "evaluate_performance.py"
run_population_combs_script       = "run_pop_combs.py"
bundle_dash_script                = "bundle_dash.py"
dash_app_script                   = "plot_embeddings_dash.py"

# =====================================================
# File Names
# =====================================================

# Base Output directories
data_output_path                  = os.path.join(output_path, "data")
plot_output_path                  = os.path.join(output_path, "plots")

# Target file names
pca_plot_file_name                = "pca.png"
demography_plot_file_name         = "demography.png"
rates_true_file_name              = "rates_true.parquet"
rates_true_plot_file_name         = "rates_true.png"
embeddings_true_file_name              = f"embeddings_true{TRUE_TAG}.parquet"
embeddings_true_plot_file_name         = f"embeddings_true{TRUE_TAG}.html"
performance_true_file_name             = f"reconstructed_rates_true{TRUE_TAG}.parquet"
performance_true_plot_file_name        = f"performance_true{TRUE_TAG}.png"
performance_true_interactive_file_name = f"performance_true{TRUE_TAG}.html"
sim_finished_file_name            = f"sim_trees_ready{SIM_TAG}.txt"
infer_finished_file_name          = f"infer_trees_ready{SIM_TAG}.txt"

if trees_dir == tree_output_path: # The case of simulation or inference
    if infer_method == "None": # Simulation
        trees_ready = sim_finished_file_name
    else: # Inference
        trees_ready = infer_finished_file_name
else: # The case of using empirical trees
    trees_ready = "trees_ready.txt"

trees_ready                       = os.path.join(trees_dir, trees_ready)

pdf_data_file_name                = f"coal_pdf{PDF_TAG}.parquet"
rates_data_file_name              = f"rates{RATES_TAG}.parquet"
rates_plot_file_name              = f"rates{RATES_TAG}.png"

embeddings_data_file_name         = f"embeddings{STT_TAG}.parquet"
embeddings_plot_file_name         = f"embeddings{PLOT_TAG}.html"
performance_data_file_name             = f"reconstructed_rates{STT_TAG}.parquet"
performance_plot_file_name             = f"performance{STT_TAG}.png"
performance_interactive_file_name      = f"performance{STT_TAG}.html"
embeddings_pyvista_plot_file_name      = f"embeddings_pyvista{PLOT_TAG}.html"
dash_launch_file_name                  = f"launch_dash{STT_TAG}.sh"
dash_launch_true_file_name             = f"launch_dash_true.Nmin{N_min}.Nmax{N_max}.sh"
dash_bundle_file_name                  = f"dash_bundle{STT_TAG}.zip"

# Target file paths
pca_plot                          = os.path.join(plot_output_path, pca_plot_file_name)
demography_plot                   = os.path.join(plot_output_path, demography_plot_file_name)
rates_true                        = os.path.join(data_output_path, rates_true_file_name)
rates_true_plot                   = os.path.join(plot_output_path, rates_true_plot_file_name)
embeddings_true                   = os.path.join(data_output_path, embeddings_true_file_name)
embeddings_true_plot              = os.path.join(plot_output_path, embeddings_true_plot_file_name)
performance_true_data             = os.path.join(data_output_path, performance_true_file_name)
performance_true_plot             = os.path.join(plot_output_path, performance_true_plot_file_name)
performance_true_interactive      = os.path.join(plot_output_path, performance_true_interactive_file_name)
sim_finished                      = os.path.join(tree_output_path, sim_finished_file_name)
infer_finished                    = os.path.join(tree_output_path, infer_finished_file_name)

pdf_data                          = os.path.join(data_output_path, pdf_data_file_name)
rates_data                        = os.path.join(data_output_path, rates_data_file_name)
rates_plot                        = os.path.join(plot_output_path, rates_plot_file_name)

embeddings_data                   = os.path.join(data_output_path, embeddings_data_file_name)
embeddings_plot                   = os.path.join(plot_output_path, embeddings_plot_file_name)
performance_data                  = os.path.join(data_output_path, performance_data_file_name)
performance_plot                  = os.path.join(plot_output_path, performance_plot_file_name)
performance_interactive           = os.path.join(plot_output_path, performance_interactive_file_name)
embeddings_pyvista_plot           = os.path.join(plot_output_path, embeddings_pyvista_plot_file_name)
dash_launch                       = os.path.join(plot_output_path, dash_launch_file_name)
dash_launch_true                  = os.path.join(plot_output_path, dash_launch_true_file_name)
dash_bundle                       = os.path.join(plot_output_path, dash_bundle_file_name)

combs_data_dir                    = os.path.join(output_path, "combs/data")
combs_plot_dir                    = os.path.join(output_path, "combs/plots")

if trees_dir != tree_output_path and not os.path.exists(trees_ready): # In the case of using trees inferred from empirical data, create the trees ready file
    Path(trees_ready).touch()

# =====================================================
# Target Groups
# =====================================================
sim_targets = [
    pop_labels,pop_colors,pca_plot,demography_plot,
    rates_true,rates_true_plot,
    embeddings_true,embeddings_true_plot,
    performance_true_data,performance_true_plot,performance_true_interactive,
    sim_finished
    ]

STT_targets = [
    pdf_data,
    rates_data, rates_plot,
    embeddings_data, embeddings_plot,
    performance_plot, performance_data, performance_interactive,
    dash_launch,
    ]

true_targets = [
    pop_labels, pop_colors,
    rates_true, rates_true_plot,
    # embeddings_true, embeddings_true_plot,
    # performance_true_data, performance_true_plot, performance_true_interactive,
    # dash_launch_true,
    ]

# =====================================================
# General Rules
# =====================================================
rule sim: # Only simulate the trees
    input: sim_targets
rule sim_STT: # Simulate and run STT on simulated trees
    input: sim_targets, STT_targets

rule infer: # Only infer the trees 
    input: infer_finished
rule infer_STT: # Infer and run STT on inferred trees
    input: infer_finished, STT_targets

rule STT: # Run STT
    input: STT_targets

# Compute true rates, embeddings, and performance without simulating trees
rule STT_true:
    input: true_targets

# =====================================================
# Specific Rules
# =====================================================

# ______________________sim Rules______________________
if pop_colors ==  os.path.join(output_path,"data/pop_colors.csv") or pop_labels == os.path.join(output_path,"data/pop_colors.csv"):
    rule preprocess_data:
        input:
            demes_file_path = demes_file_path,
            script = preprocess_demography_script
        output:
            pop_colors,
            pop_labels
        params:
            outdir = data_output_path,
            n_per_pop = n_sim_per_pop
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --demes_file_path {input.demes_file_path} \
                --output_path {params.outdir} \
                --n {params.n_per_pop}
            """
rule plot_demography:
    input:
        demes_file_path = demes_file_path,
        pop_colors = pop_colors,
        script = plot_demography_script
    output:
        demography_plot
    params:
        outdir = plot_output_path,
        min_time = min_time,
        max_time = max_time,
        time_scale = time_scale
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --output_path {params.outdir} \
            --min_time {params.min_time} \
            --max_time {params.max_time} \
            --time_scale {params.time_scale}
        """

rule run_pca:
    input:
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        demes_file_path = demes_file_path,
        script = pca_script
    output:
        pca_plot
    params:
        outdir = plot_output_path,
        n_per_pop = n_sim_per_pop,
        phased = phased
    shell:
        """
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --n {params.n_per_pop} \
            --phased {params.phased}
        """

rule compute_rates_true:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = compute_rates_true_script
    output:
        rates_true
    params:
        outdir = data_output_path,
        max_time = max_time,
        phased = phased
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --max_time {params.max_time} \
            --labels {input.pop_labels} \
            --phased {params.phased}
        """
rule plot_rates_true:
    input:
        rates = rates_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_rates_script
    output:
        rates_true_plot
    params:
        outdir = plot_output_path,
        output_name = rates_true_plot_file_name,
        min_time = min_time,
        max_rate_plot = max_rate_plot,
        time_scale = time_scale,
        phased = phased
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --min_time {params.min_time} \
            --max_rate_plot {params.max_rate_plot} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --time_scale {params.time_scale} \
            --phased {params.phased}
        """
rule compute_embeddings_true:
    input:
        rates = rates_true,
        script = compute_embeddings_wrapper_script,
        main_script = COMPUTE_EMBEDDINGS_SCRIPT
    output:
        embeddings_true
    params:
        outdir = data_output_path,
        output_name = embeddings_true_file_name,
        N_min = N_min,
        N_max = N_max,
        k = k,
        link = link,
        n_components = n_components,
        n_timepoints_emb = n_timepoints_emb,
        phased = phased
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --k {params.k} \
            --link {params.link} \
            --n_components {params.n_components} \
            --n_timepoints_emb {params.n_timepoints_emb} \
            --phased {params.phased}
        """

rule plot_embeddings_true:
    input:
        embeddings = embeddings_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_embeddings_wrapper_script,
        main_script = PLOT_EMBEDDINGS_SCRIPT
    output:
        embeddings_true_plot,
        dash_script = dash_launch_true,
    params:
        outdir = plot_output_path,
        output_name = embeddings_true_plot_file_name,
        min_time = min_time,
        embeddings_plot_lims = embeddings_plot_lims,
        embeddings_max_time = embeddings_max_time,
        time_scale = time_scale,
        N_max = N_max,
        rates_path = rates_true,
        reconstructed_rates_path = performance_true_data,
        phased = phased,
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.embeddings} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --lims {params.embeddings_plot_lims} \
            --min_time {params.min_time} \
            --max_time {params.embeddings_max_time} \
            --time_scale {params.time_scale} \
            --phased {params.phased}
        cat > {output.dash_script} << 'DASHEOF'
#!/bin/bash
# Run from the utils/ directory
python plot_embeddings_dash.py \\
    {input.embeddings} \\
    --labels {input.pop_labels} \\
    --colors {input.pop_colors} \\
    --rates {params.rates_path} \\
    --reconstructed_rates {params.reconstructed_rates_path} \\
    --N_max {params.N_max} \\
    --time_scale {params.time_scale} \\
    --min_time {params.min_time} \\
    --max_time {params.embeddings_max_time}
DASHEOF
        chmod +x {output.dash_script}
        """

rule evaluate_performance_true:
    input:
        embeddings = embeddings_true,
        rates = rates_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = evaluate_performance_script
    output:
        performance_true_data,
        performance_true_plot,
        performance_true_interactive
    params:
        N_min = N_min,
        N_max = N_max,
        k = k,
        link = link,
        data_output_path = data_output_path,
        plot_output_path = plot_output_path,
        data_output_name = performance_true_file_name,
        plot_output_name = performance_true_plot_file_name,
        min_time = min_time,
        max_rate_plot = max_rate_plot,
        time_scale = time_scale,
        phased = phased
    shell:
        """
        python {input.script} \
            --embeddings {input.embeddings} \
            --rates {input.rates} \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --k {params.k} \
            --link {params.link} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --data_output_path {params.data_output_path} \
            --plot_output_path {params.plot_output_path} \
            --data_output_name {params.data_output_name} \
            --plot_output_name {params.plot_output_name} \
            --min_time {params.min_time} \
            --max_rate_plot {params.max_rate_plot} \
            --time_scale {params.time_scale} \
            --phased {params.phased}
        """

rule simulate_trees:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = simulate_trees_script
    output:
        sim_finished
    params:
        outdir = tree_output_path,
        num_contigs = num_contigs,
        contig_length = contig_length,
        sim_params = sim_finished_file_name,
        mu = mutation_rate,
        r = recombination_rate,
        num_threads = num_threads
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --labels {input.pop_labels} \
            --num_contigs {params.num_contigs} \
            --contig_length {params.contig_length} \
            --sim_params {params.sim_params} \
            --mu {params.mu} \
            --r {params.r} \
            --num_threads {params.num_threads}

        """
# # ______________________infer Rules_____________________
rule infer_trees:
    input:
        vcf_dir = vcf_dir,
        sim_finished = os.path.join(vcf_dir,sim_finished_file_name),
        script = infer_trees_script
    output:
        infer_finished
    params:
        outdir = tree_output_path,
        output_name = infer_finished_file_name,
        method = infer_method,
        contig_length = contig_length,
        num_posterior_samples = num_posterior_samples,
        thinning_interval = thinning_interval,
        burnin = burnin,
        mu = mutation_rate,
        r = recombination_rate,
        num_threads = num_threads
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --vcf_dir {input.vcf_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --method {params.method} \
            --contig_length {params.contig_length} \
            --num_posterior_samples {params.num_posterior_samples} \
            --thinning_interval {params.thinning_interval} \
            --burnin {params.burnin} \
            --mu {params.mu} \
            --r {params.r} \
            --num_threads {params.num_threads}
        """
# # ______________________rates Rules_____________________
rule compute_pdf:
    input:
        main_script = COUNT_COAL_EVENTS_SCRIPT,
        script = compute_pdf_wrapper_script,
        pop_labels = pop_labels,
        trees_ready = trees_ready
    params:
        trees_dir = trees_dir,
        outdir = data_output_path,
        output_name = os.path.basename(pdf_data),
        max_time = max_time,
        n_timepoints = n_timepoints,
        n_samples_per_pop = n_samples_per_pop,
        num_posterior_samples = num_posterior_samples,
        fraction_samples = fraction_samples,
        pops = pops,
        num_threads = num_threads

    output:
        pdf_data
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.trees_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
            --pops {params.pops} \
            --num_posterior_samples {params.num_posterior_samples} \
            --n_samples_per_pop {params.n_samples_per_pop} \
            --fraction_samples {params.fraction_samples} \
            --pop_labels {input.pop_labels} \
            --num_threads {params.num_threads}
        """

rule compute_rates:
    input:
        pdf_data = pdf_data,
        pop_labels = pop_labels,
        script = compute_rates_wrapper_script,
        main_script = COMPUTE_RATES_SCRIPT
    output:
        rates_data
    params:
        outdir = data_output_path,
        output_name = rates_data_file_name,
        min_window_size = min_window_size,
        max_window_size = max_window_size,
        phased = phased
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_data} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --minimum_window_size {params.min_window_size} \
            --maximum_window_size {params.max_window_size} \
            --pop_labels {input.pop_labels} \
            --phased {params.phased}
        """

rule plot_rates:
    input:
        rates = rates_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_rates_script
    output:
        rates_plot
    params:
        outdir = plot_output_path,
        output_name = rates_plot_file_name,
        min_time = min_time,
        max_rate_plot = max_rate_plot,
        time_scale = time_scale,
