# ______________________ancestry-specific STT Rules________________________
# Repeats the STT rules above once per reference/ancestry population label,
# rooted at {ancestry_STT_path}/{ancestry}/data and .../plots instead of
# data_output_path/plot_output_path. Ancestry labels are only known once the
# infer_local_ancestry checkpoint has run (reference_pops may be None in
# config, defaulted internally by infer_local_ancestry.py), so these are
# plain wildcard rules driven by the aggregator function/sentinel rule below.
if admix_mode:
    def ancestry_data_dir(ancestry):  return os.path.join(ancestry_STT_path, ancestry, "data")
    def ancestry_plot_dir(ancestry):  return os.path.join(ancestry_STT_path, ancestry, "plots")

    rule compute_rates_ancestry:
        input:
            ancestry_flag = compute_pdf_ancestry_flag,
            pop_labels = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_labels.csv"),
            script = compute_rates_wrapper_script,
            main_script = COMPUTE_RATES_SCRIPT
        output:
            os.path.join(ancestry_STT_path, "{ancestry}", "data", rates_data_file_name)
        params:
            outdir = lambda wc: ancestry_data_dir(wc.ancestry),
            output_name = rates_data_file_name,
            pdf_data = lambda wc: os.path.join(ancestry_data_dir(wc.ancestry), pdf_data_file_name),
            min_window_size = min_window_size,
            max_window_size = max_window_size,
            per_haplotype = "--per-haplotype" if per_haplotype else "",
            compute_variance = "--compute_variance" if compute_variance else ""
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --pdf_path {params.pdf_data} \
                --output_path {params.outdir} \
                --output_name {params.output_name} \
                --minimum_window_size {params.min_window_size} \
                --maximum_window_size {params.max_window_size} \
                --pop_labels {input.pop_labels} \
                {params.per_haplotype} \
                {params.compute_variance}
            """

    rule plot_rates_ancestry:
        input:
            rates = os.path.join(ancestry_STT_path, "{ancestry}", "data", rates_data_file_name),
            pop_colors = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_colors.csv"),
            pop_labels = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_labels.csv"),
            script = plot_rates_script
        output:
            os.path.join(ancestry_STT_path, "{ancestry}", "plots", rates_plot_file_name)
        params:
            outdir = lambda wc: ancestry_plot_dir(wc.ancestry),
            output_name = rates_plot_file_name,
            min_time = min_time,
            max_rate_plot = max_rate_plot,
            time_scale = time_scale,
            per_haplotype = "--per-haplotype" if per_haplotype else ""
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --input {input.rates} \
                --colors {input.pop_colors} \
                --labels {input.pop_labels} \
                --min_time {params.min_time} \
                --max_rate_plot {params.max_rate_plot} \
                --output_path {params.outdir} \
                --output_name {params.output_name} \
                --time_scale {params.time_scale} \
                {params.per_haplotype}
            """

    rule plot_relative_div_ancestry:
        input:
            rates = os.path.join(ancestry_STT_path, "{ancestry}", "data", rates_data_file_name),
            pop_colors = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_colors.csv"),
            pop_labels = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_labels.csv"),
            script = plot_relative_div_script
        output:
            os.path.join(ancestry_STT_path, "{ancestry}", "plots", relative_div_plot_file_name),
            os.path.join(ancestry_STT_path, "{ancestry}", "plots", relative_div_plot_summary_file_name)
        params:
            outdir = lambda wc: ancestry_plot_dir(wc.ancestry),
            output_name = relative_div_plot_file_name,
            min_time = min_time,
            time_scale = time_scale,
            per_haplotype = "--per-haplotype" if per_haplotype else ""
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --input {input.rates} \
                --colors {input.pop_colors} \
                --labels {input.pop_labels} \
                --min_time {params.min_time} \
                --output_path {params.outdir} \
                --output_name {params.output_name} \
                --time_scale {params.time_scale} \
                {params.per_haplotype}
            """

    rule compute_embeddings_ancestry:
        input:
            rates = os.path.join(ancestry_STT_path, "{ancestry}", "data", rates_data_file_name),
            script = compute_embeddings_wrapper_script,
            main_script = COMPUTE_EMBEDDINGS_SCRIPT,
            support_script = OPTIMIZATION_FUNCTIONS_SCRIPT
        output:
            os.path.join(ancestry_STT_path, "{ancestry}", "data", embeddings_data_file_name),
            os.path.join(ancestry_STT_path, "{ancestry}", "data", reconstructed_rates_file_name)
        params:
            N_min = N_min,
            N_max = N_max,
            p = p,
            link = link,
            l1_penalties = l1_penalties,
            l2_penalties = l2_penalties,
            outdir = lambda wc: ancestry_data_dir(wc.ancestry),
            output_name = embeddings_data_file_name,
            reconstructed_rates_output_name = reconstructed_rates_file_name,
            n_components = n_components,
            n_timepoints_emb = n_timepoints_emb,
