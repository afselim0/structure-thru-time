# =====================================================
# File Names
# =====================================================
# Base Output directories
data_output_path                       = os.path.join(output_path, "data")
plot_output_path                       = os.path.join(output_path, "plots")
# Both are namespaced by LAI_method (LAI/RFmix, LAI/GNN, LAI/True and the
# matching ancestry_STT subdirectory) so runs using different local ancestry
# methods can share one output_path without overwriting each other.
LAI_root_path                           = os.path.join(output_path, "LAI")
LAI_path                                = os.path.join(LAI_root_path, LAI_method)
ancestry_STT_path                       = os.path.join(output_path, "ancestry_STT", LAI_method)
# Genome-wide ancestry proportions: the hand-off between the (expensive,
# threshold-independent) LAI rule and the (cheap, threshold-dependent)
# select_ancestry_samples checkpoint. Name matches
# TOTAL_ANCESTRY_PROPORTIONS_FILE in infer_local_ancestry.py.
ancestry_proportions                    = os.path.join(LAI_path, "total_ancestry_proportions.parquet")

# Ancestry/reference-panel labels are directory names under ancestry_STT_path and
# appear as a wildcard in every per-ancestry rule below. Constrain them to the same
# charset the reference_pops validation enforces, so a label can never eat a path
# separator: snakemake's default wildcard regex is greedy and matches across "/",
# which would silently mis-resolve rather than fail.
wildcard_constraints:
    ancestry = r"[A-Za-z0-9_.-]+",
    label    = r"[A-Za-z0-9_.-]+",

# Target file names
pca_data_file_name                                      = f"pca{PCA_TAG}.csv"
# The PCA table itself is a genotype GRM and does not depend on per_haplotype, but
# the plot does: plot_pca.py colours by sample_id vs individual_id. So only the plot
# carries PHASE_TAG, and both settings still share the one expensive PCA.
pca_plot_file_name                                      = f"pca{PCA_TAG}{PHASE_TAG}.png"
demography_plot_file_name                               = "demography.png"
rates_true_file_name                                    = f"rates_true{TRUE_RATES_TAG}.parquet"
rates_true_plot_file_name                               = f"rates_true{TRUE_RATES_TAG}.png"
embeddings_true_file_name                               = f"embeddings_true{TRUE_TAG}.parquet"
embeddings_true_plot_file_name                          = f"embeddings_true{TRUE_TAG}.html"
reconstructed_rates_true_file_name                      = f"reconstructed_rates_true{TRUE_TAG}.parquet"
input_vs_reconstructed_rates_true_plot_file_name        = f"input_vs_reconstructed_rates_true{TRUE_TAG}.png"
input_vs_reconstructed_rates_true_interactive_file_name = f"input_vs_reconstructed_rates_true{TRUE_TAG}.html"
sim_finished_file_name                                  = f"sim_trees_ready{SIM_TAG}.txt"
infer_finished_file_name                                = f"infer_trees_ready{SIM_TAG}.txt"

if trees_dir == tree_output_path: # The case of simulation or inference
    if infer_method == "None": # Simulation
        trees_ready = sim_finished_file_name
    else: # Inference
        trees_ready = infer_finished_file_name
else: # The case of using empirical trees
    trees_ready = "trees_ready.txt"

trees_ready                            = os.path.join(trees_dir, trees_ready)

pdf_data_file_name                     = f"coal_pdf{PDF_TAG}.parquet"
rates_data_file_name                   = f"rates{RATES_TAG}.parquet"
weights_data_file_name                 = f"weights_rates{RATES_TAG}.parquet"
rates_plot_file_name                   = f"rates{RATES_TAG}.png"
effective_size_plot_file_name          = f"effective_size{RATES_TAG}.png"
relative_div_plot_file_name            = f"relative_div{RATES_TAG}.png"
relative_div_plot_summary_file_name    = f"relative_div{RATES_TAG}_summary.png"

embeddings_data_file_name                                = f"embeddings{STT_TAG}.parquet"
embeddings_plot_file_name                                = f"embeddings{PLOT_TAG}.html"
reconstructed_rates_file_name                            = f"reconstructed_rates{STT_TAG}.parquet"
input_vs_reconstructed_rates_plot_file_name             = f"input_vs_reconstructed_rates{STT_TAG}.png"
input_vs_reconstructed_rates_interactive_file_name      = f"input_vs_reconstructed_rates{STT_TAG}.html"
true_rates_vs_reconstructed_rates_plot_file_name        = f"true_rates_vs_reconstructed_rates{STT_TAG}.png"
true_rates_vs_reconstructed_rates_interactive_file_name = f"true_rates_vs_reconstructed_rates{STT_TAG}.html"
embeddings_pyvista_plot_file_name                        = f"embeddings_pyvista{PLOT_TAG}.html"
dash_launch_file_name                                    = f"launch_dash{STT_TAG}.sh"
dash_launch_true_file_name                               = f"launch_dash_true.Nmin{N_min}.Nmax{N_max}.sh"
dash_bundle_file_name                                    = f"dash_bundle{STT_TAG}.zip"

# Smoothed (joint-optimization) counterparts, tagged with the actual L1 penalties (SMOOTH_TAG).
# Only produced when smoothing_on; mirror the unsmoothed names above.
smooth_embeddings_data_file_name                                = f"smooth_embeddings{SMOOTH_TAG}.parquet"
smooth_embeddings_plot_file_name                                = f"smooth_embeddings{SMOOTH_PLOT_TAG}.html"
smooth_reconstructed_rates_file_name                            = f"smooth_reconstructed_rates{SMOOTH_TAG}.parquet"
smooth_input_vs_reconstructed_rates_plot_file_name             = f"smooth_input_vs_reconstructed_rates{SMOOTH_TAG}.png"
smooth_input_vs_reconstructed_rates_interactive_file_name      = f"smooth_input_vs_reconstructed_rates{SMOOTH_TAG}.html"
smooth_true_rates_vs_reconstructed_rates_plot_file_name        = f"smooth_true_rates_vs_reconstructed_rates{SMOOTH_TAG}.png"
smooth_true_rates_vs_reconstructed_rates_interactive_file_name = f"smooth_true_rates_vs_reconstructed_rates{SMOOTH_TAG}.html"
smooth_dash_launch_file_name                                    = f"launch_dash_smooth{SMOOTH_TAG}.sh"

# Scan diagnostics file names (one row per swept value, per rates comparison)
scan_p_file_name                                          = f"scan_p{STT_TAG_NO_P}.csv"
scan_d_file_name                                          = f"scan_d{STT_TAG_NO_D}.csv"

# Target file paths
pca_data                          = os.path.join(data_output_path, pca_data_file_name)
pca_plot                          = os.path.join(plot_output_path, pca_plot_file_name)
demography_plot                   = os.path.join(plot_output_path, demography_plot_file_name)
rates_true                        = os.path.join(data_output_path, rates_true_file_name)
rates_true_plot                   = os.path.join(plot_output_path, rates_true_plot_file_name)
embeddings_true                   = os.path.join(data_output_path, embeddings_true_file_name)
embeddings_true_plot              = os.path.join(plot_output_path, embeddings_true_plot_file_name)
reconstructed_rates_true             = os.path.join(data_output_path, reconstructed_rates_true_file_name)
input_vs_reconstructed_rates_true_plot             = os.path.join(plot_output_path, input_vs_reconstructed_rates_true_plot_file_name)
input_vs_reconstructed_rates_true_interactive      = os.path.join(plot_output_path, input_vs_reconstructed_rates_true_interactive_file_name)
sim_finished                      = os.path.join(tree_output_path, sim_finished_file_name)
infer_finished                    = os.path.join(tree_output_path, infer_finished_file_name)

pdf_data                          = os.path.join(data_output_path, pdf_data_file_name)
rates_data                        = os.path.join(data_output_path, rates_data_file_name)
weights_data                      = os.path.join(data_output_path, weights_data_file_name)
rates_plot                        = os.path.join(plot_output_path, rates_plot_file_name)
effective_size_plot               = os.path.join(plot_output_path, effective_size_plot_file_name)
relative_div_plot                 = os.path.join(plot_output_path, relative_div_plot_file_name)
relative_div_plot_summary         = os.path.join(plot_output_path, relative_div_plot_summary_file_name)

embeddings_data                   = os.path.join(data_output_path, embeddings_data_file_name)
embeddings_plot                   = os.path.join(plot_output_path, embeddings_plot_file_name)
slice_2d_file_name                = f"2d_slice{PLOT_TAG}.png"
slice_2d                          = os.path.join(plot_output_path, slice_2d_file_name)
reconstructed_rates                  = os.path.join(data_output_path, reconstructed_rates_file_name)
input_vs_reconstructed_rates_plot                  = os.path.join(plot_output_path, input_vs_reconstructed_rates_plot_file_name)
input_vs_reconstructed_rates_interactive           = os.path.join(plot_output_path, input_vs_reconstructed_rates_interactive_file_name)
true_rates_vs_reconstructed_rates_plot             = os.path.join(plot_output_path, true_rates_vs_reconstructed_rates_plot_file_name)
true_rates_vs_reconstructed_rates_interactive      = os.path.join(plot_output_path, true_rates_vs_reconstructed_rates_interactive_file_name)

# Smoothed counterpart paths
smooth_embeddings_data                        = os.path.join(data_output_path, smooth_embeddings_data_file_name)
smooth_embeddings_plot                        = os.path.join(plot_output_path, smooth_embeddings_plot_file_name)
smooth_slice_2d_file_name                     = f"smooth_2d_slice{SMOOTH_PLOT_TAG}.png"
smooth_slice_2d                               = os.path.join(plot_output_path, smooth_slice_2d_file_name)
smooth_reconstructed_rates                    = os.path.join(data_output_path, smooth_reconstructed_rates_file_name)
smooth_input_vs_reconstructed_rates_plot        = os.path.join(plot_output_path, smooth_input_vs_reconstructed_rates_plot_file_name)
smooth_input_vs_reconstructed_rates_interactive = os.path.join(plot_output_path, smooth_input_vs_reconstructed_rates_interactive_file_name)
smooth_true_rates_vs_reconstructed_rates_plot        = os.path.join(plot_output_path, smooth_true_rates_vs_reconstructed_rates_plot_file_name)
smooth_true_rates_vs_reconstructed_rates_interactive = os.path.join(plot_output_path, smooth_true_rates_vs_reconstructed_rates_interactive_file_name)
smooth_dash_launch                            = os.path.join(plot_output_path, smooth_dash_launch_file_name)
embeddings_pyvista_plot           = os.path.join(plot_output_path, embeddings_pyvista_plot_file_name)
dash_launch                       = os.path.join(plot_output_path, dash_launch_file_name)
dash_launch_true                  = os.path.join(plot_output_path, dash_launch_true_file_name)
dash_bundle                       = os.path.join(plot_output_path, dash_bundle_file_name)
scan_p_output                     = os.path.join(data_output_path, scan_p_file_name)
scan_d_output                     = os.path.join(data_output_path, scan_d_file_name)
scan_p_outdir                     = os.path.join(data_output_path, "scan_p")
scan_d_outdir                     = os.path.join(data_output_path, "scan_d")

# Replicate embeddings file names (one per seed)
embeddings_replicate_data              = [os.path.join(data_output_path, f"embeddings_seed{s}{STT_TAG}.parquet") for s in seeds]
replicates_panel_file_name             = f"replicates_panel{PLOT_TAG}.png"
replicates_panel                       = os.path.join(plot_output_path, replicates_panel_file_name)
replicates_2d_slice_file_name          = f"replicates_2d_slice{PLOT_TAG}.png"
replicates_2d_slice                    = os.path.join(plot_output_path, replicates_2d_slice_file_name)
replicates_ggpairs_file_name           = f"replicates_ggpairs{PLOT_TAG}.png"
replicates_ggpairs                     = os.path.join(plot_output_path, replicates_ggpairs_file_name)
replicates_performance_panel_file_name = f"replicates_performance_panel{PLOT_TAG}.png"
replicates_performance_panel           = os.path.join(plot_output_path, replicates_performance_panel_file_name)

# Pairwise rates comparison plots between replicates (all ordered pairs i < j)
replicate_comparison_plots        = [
    f
    for sa, sb in combinations(seeds, 2)
    for f in [
        os.path.join(plot_output_path, f"rates_comparison_seed{sa}_vs_seed{sb}{PLOT_TAG}.png"),
        os.path.join(plot_output_path, f"rates_comparison_seed{sa}_vs_seed{sb}{PLOT_TAG}.html"),
    ]
]

if trees_dir != tree_output_path and not os.path.exists(trees_ready): # In the case of using trees inferred from empirical data, create the trees ready file
    Path(trees_ready).touch()

# =====================================================
# Target Groups
# =====================================================
true_targets = [pop_labels, pop_colors]
if not is_SS_demography: # True coalescence rates are not computable for SS (stepping-stone) demographies
    true_targets = true_targets + [
        rates_true, rates_true_plot,
        embeddings_true, embeddings_true_plot,
        reconstructed_rates_true, input_vs_reconstructed_rates_true_plot, input_vs_reconstructed_rates_true_interactive,
        dash_launch_true]

sim_targets = [sim_finished] + ([] if is_SS_demography else [demography_plot])

STT_targets = [
    pdf_data,
    pca_data, pca_plot,
    rates_data, rates_plot, effective_size_plot,
    embeddings_data, embeddings_plot,
    slice_2d,
    reconstructed_rates, input_vs_reconstructed_rates_plot, input_vs_reconstructed_rates_interactive,
    dash_launch,
    ]

if demes_file_path and not is_SS_demography: # Ground-truth demographic rates are only available for simulated, non-SS demographies
    STT_targets = STT_targets + [rates_true, true_rates_vs_reconstructed_rates_plot, true_rates_vs_reconstructed_rates_interactive]

if not is_SS_demography: # Relative divergence plot is not applicable to stepping-stone simulations
    STT_targets = STT_targets + [relative_div_plot, relative_div_plot_summary]

if admix_mode:
    STT_targets = STT_targets + [os.path.join(output_path, f"ancestry_STT_done.{LAI_method}.flag")]

if scan_p_mode:
    STT_targets = STT_targets + [scan_p_output]

if scan_d_mode:
    STT_targets = STT_targets + [scan_d_output]

# Smoothed (joint-optimization) targets: a full parallel set to the unsmoothed STT outputs, produced
# only when smoothing penalties are set. Mirrors the conditional structure of the unsmoothed targets.
if smoothing_on:
    smooth_targets = [
        smooth_embeddings_data, smooth_embeddings_plot,
        smooth_slice_2d,
        smooth_reconstructed_rates,
        smooth_input_vs_reconstructed_rates_plot, smooth_input_vs_reconstructed_rates_interactive,
        smooth_dash_launch,
    ]
    if demes_file_path and not is_SS_demography: # Ground-truth demographic rates available (non-SS)
        smooth_targets = smooth_targets + [
            smooth_true_rates_vs_reconstructed_rates_plot,
            smooth_true_rates_vs_reconstructed_rates_interactive,
        ]
    STT_targets = STT_targets + smooth_targets

replicates_targets = ([rates_data]
                      + embeddings_replicate_data
                      + ([replicates_panel]                  if seeds else [])
                      + ([replicates_2d_slice]               if seeds else [])
                      + ([replicates_ggpairs]                if len(seeds) > 1 else [])
                      + ([replicates_performance_panel]      if seeds else []))

# =====================================================
# General Rules
# =====================================================
rule STT_true:# Compute true rates, embeddings, and performance without simulating trees
    input: true_targets

rule sim: # Compute true targets and simulate the trees
    input: sim_targets
rule STT_sim: # Simulate and run STT on simulated trees
    input: sim_targets, STT_targets

rule infer: # Only infer the trees 
    input: infer_finished
rule STT_infer: # Infer and run STT on inferred trees
    input: infer_finished, STT_targets

rule STT: # Run STT
    input: STT_targets

rule STT_replicates: # Run multiple replicate optimizations with different seeds (rates computed once)
    input: replicates_targets

# =====================================================
# Specific Rules
# =====================================================

# ______________________sim Rules______________________
if demes_file_path: # A demes file path is specified
    rule preprocess_data:
        input:
            demes_file_path = demes_file_path,
            script = preprocess_demography_script
        output:
            pop_colors,
            pop_labels
        params:
            outdir = data_output_path,
            n_per_pop = n_sim_per_pop
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --demes_file_path {input.demes_file_path} \
                --output_path {params.outdir} \
                --n {params.n_per_pop}
            """
    rule plot_demography:
        input:
            demes_file_path = demes_file_path,
            pop_colors = pop_colors,
            script = plot_demography_script
        output:
            demography_plot
        params:
            outdir = plot_output_path,
            min_time = embeddings_min_time,
            max_time = embeddings_max_time,
            time_scale = time_scale
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --demes_file_path {input.demes_file_path} \
                --colors {input.pop_colors} \
                --output_path {params.outdir} \
                --min_time {params.min_time} \
                --max_time {params.max_time} \
                --time_scale {params.time_scale}
            """
else: # No demes file path: this is an empirical run, slice the user-supplied pop_labels/pop_colors instead
    if not raw_pop_labels or not raw_pop_colors:
        raise ValueError("pop_labels and pop_colors must be specified in the config when demes_file_path is not provided (empirical run).")
    rule preprocess_data:
        input:
            pop_labels = raw_pop_labels,
            pop_colors = raw_pop_colors,
            script = preprocess_samples_script
        output:
            pop_colors,
            pop_labels
        params:
            outdir = data_output_path,
            pops = pops,
            n_samples_per_pop = n_samples_per_pop,
            seed = subsample_seed
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --pop_labels {input.pop_labels} \
                --pop_colors {input.pop_colors} \
                --output_path {params.outdir} \
                --pops {params.pops} \
                --n_samples_per_pop {params.n_samples_per_pop} \
                --seed {params.seed}
            """

# Genotype PCA over the run's tree sequences: a structure summary independent of
# the coalescent-rate machinery, drawn with the same labels/colours as the
# embeddings plots. run_pca accumulates the GRM chunk by chunk rather than
# stacking the genome-wide genotype matrix (see run_pca.py for why).
rule run_pca:
    input:
        pop_labels = pop_labels,
        trees_ready = trees_ready,
        script = pca_script
    output:
        pca_data
    params:
        trees_dir = trees_dir,
        outdir = data_output_path,
        output_name = pca_data_file_name,
        num_threads = num_threads
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.trees_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --pop_labels {input.pop_labels} \
            --num_threads {params.num_threads}
        """

rule plot_pca:
    input:
        pca = pca_data,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_pca_script
    output:
        pca_plot
    params:
        outdir = plot_output_path,
        output_name = pca_plot_file_name,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.pca} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            {params.per_haplotype}
        """

rule compute_rates_true:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = compute_rates_true_script
    output:
        rates_true
    params:
        outdir = data_output_path,
        output_name = rates_true_file_name,
        rates_min_time = rates_min_time,
        rates_max_time = rates_max_time,
        pdf_bin_size = pdf_bin_size,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --rates_min_time {params.rates_min_time} \
            --rates_max_time {params.rates_max_time} \
            --pdf_bin_size {params.pdf_bin_size} \
            --labels {input.pop_labels} \
            {params.per_haplotype}
        """
rule plot_rates_true:
    input:
        rates = rates_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_rates_script
    output:
        rates_true_plot
    params:
        outdir = plot_output_path,
        output_name = rates_true_plot_file_name,
        min_time = rates_min_time,
        max_rate_plot = max_rate_plot,
        time_scale = time_scale,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --min_time {params.min_time} \
            --max_rate_plot {params.max_rate_plot} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --time_scale {params.time_scale} \
            {params.per_haplotype}
        """
rule compute_embeddings_true:
    input:
        rates = rates_true,
        script = compute_embeddings_wrapper_script,
        main_script = COMPUTE_EMBEDDINGS_SCRIPT
    output:
        embeddings_true,
        reconstructed_rates_true
    params:
        outdir = data_output_path,
        output_name = embeddings_true_file_name,
        reconstructed_rates_output_name = reconstructed_rates_true_file_name,
        N_min = N_min,
        N_max = N_max,
        p = p,
        link = link,
        n_components = n_components,
        n_timepoints_emb = n_timepoints_emb,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --reconstructed_rates_output_name {params.reconstructed_rates_output_name} \
            --N_min {params.N_min} \
            --N_max {params.N_max} \
            --p {params.p} \
            --link {params.link} \
            --n_components {params.n_components} \
            --n_timepoints_emb {params.n_timepoints_emb} \
            {params.per_haplotype}
        """

rule plot_embeddings_true:
    input:
        embeddings = embeddings_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = plot_embeddings_wrapper_script,
        main_script = PLOT_EMBEDDINGS_SCRIPT
    output:
        embeddings_true_plot,
        dash_script = dash_launch_true,
    params:
        utils_abs = UTILS_DIR_ABS,
        outdir = plot_output_path,
        output_name = embeddings_true_plot_file_name,
        min_time = embeddings_min_time,
        embeddings_plot_lims = embeddings_plot_lims,
        embeddings_max_time = embeddings_max_time,
        time_scale = time_scale,
        N_max = N_max,
        rates_path = rates_true,
        reconstructed_rates_path = reconstructed_rates_true,
        per_haplotype = "--per-haplotype" if per_haplotype else "",
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.embeddings} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --lims {params.embeddings_plot_lims} \
            --min_time {params.min_time} \
            --max_time {params.embeddings_max_time} \
            --time_scale {params.time_scale} \
            {params.per_haplotype}
        cat > {output.dash_script} << 'DASHEOF'
#!/bin/bash
# Self-anchoring: the app path is absolute, so this runs from any directory.
python {params.utils_abs}/plot_embeddings_dash.py \\
    {input.embeddings} \\
    --labels {input.pop_labels} \\
    --colors {input.pop_colors} \\
    --rates {params.rates_path} \\
    --reconstructed_rates {params.reconstructed_rates_path} \\
    --N_max {params.N_max} \\
    --time_scale {params.time_scale} \\
    --min_time {params.min_time} \\
    --max_time {params.embeddings_max_time}
DASHEOF
        chmod +x {output.dash_script}
        """

rule evaluate_performance_true:
    input:
        rates = rates_true,
        reconstructed_rates = reconstructed_rates_true,
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        script = evaluate_performance_script
    output:
        input_vs_reconstructed_rates_true_plot,
        input_vs_reconstructed_rates_true_interactive
    params:
        N_max = N_max,
        plot_output_path = plot_output_path,
        hist2d_output_name = input_vs_reconstructed_rates_true_plot_file_name,
        interactive_output_name = input_vs_reconstructed_rates_true_interactive_file_name,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        python {input.script} \
            --rates {input.rates} \
            --reconstructed_rates {input.reconstructed_rates} \
            --N_max {params.N_max} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --plot_output_path {params.plot_output_path} \
            --hist2d_output_name {params.hist2d_output_name} \
            --interactive_output_name {params.interactive_output_name} \
            {params.per_haplotype}
        """

rule simulate_trees:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = simulate_trees_script
    output:
        sim_finished
    params:
        outdir = tree_output_path,
        num_contigs = num_contigs,
        contig_length = contig_length,
        sim_params = sim_finished_file_name,
        mu = mutation_rate,
        r = recombination_rate,
        num_threads = num_threads,
        # Ground-truth local ancestry always lands in LAI/True/, independent of
        # the active LAI_method, so it stays available as a reference for runs
        # that infer ancestry with RFmix or GNN.
        true_LAI_path = os.path.join(LAI_root_path, "True")
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --labels {input.pop_labels} \
            --num_contigs {params.num_contigs} \
            --contig_length {params.contig_length} \
            --sim_params {params.sim_params} \
            --mu {params.mu} \
            --r {params.r} \
            --num_threads {params.num_threads} \
            --true_LAI_path {params.true_LAI_path}

        """
# # ______________________infer Rules_____________________
rule infer_trees:
    input:
        sim_trees_dir = sim_trees_dir,
        sim_finished = os.path.join(sim_trees_dir,sim_finished_file_name),
        script = infer_trees_script
    output:
        infer_finished
    params:
        outdir = tree_output_path,
        output_name = infer_finished_file_name,
        method = infer_method,
        num_contigs = num_infer_contigs,
        thinning_interval = thinning_interval,
        burnin = burnin,
        # POLEGON re-dates the retained SINGER draw; ignored by the other methods.
        polegon = "" if singer_polegon else "--no_polegon",
        mu = mutation_rate,
        r = recombination_rate,
        num_threads = num_threads
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --sim_dir {input.sim_trees_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --method {params.method} \
            --num_contigs {params.num_contigs} \
            --burnin {params.burnin} \
            --thinning_interval {params.thinning_interval} \
            --mu {params.mu} \
            --r {params.r} \
            --num_threads {params.num_threads} \
            {params.polegon}
        """
# ______________________admixture Rules____________________
if admix_mode:
    # Local ancestry inference proper. Deliberately knows nothing about
    # significant_ancestry_threshold — that only affects which samples enter
    # each ancestry-specific STT, and lives in select_ancestry_samples below,
    # so re-thresholding never re-runs this (expensive) step.
    rule infer_local_ancestry:
        input:
            trees_ready = trees_ready,
            pop_labels  = pop_labels,
            script      = infer_local_ancestry_script,
        output:
            # LAI_dir is only an output of this rule when ancestry is actually
            # inferred here. Under LAI_method='True' the directory is filled by
            # simulate_trees.py, and declaring it as an output would make
            # Snakemake delete those ground-truth files before this rule runs.
            # The proportions parquet is written in every method branch, so it
            # is the tracked output that always anchors this rule in the DAG.
            **({} if LAI_method == "True" else {"LAI_dir": directory(LAI_path)}),
            ancestry_proportions = ancestry_proportions,
        params:
            # trees_dir is passed as a param, not an input: it is only produced
            # as a side effect of simulate_trees/infer_trees (whose tracked
            # output is the trees_ready sentinel inside it), so requiring it as
            # an input directory would fail on a fresh run.
            input_path         = trees_dir,
            LAI_dir            = LAI_path,
            r                  = recombination_rate,
            mu                 = mutation_rate,
            # Quoted per element: population names are free-form metadata and may
            # contain spaces (the chimp panel has one literally named "W x C"),
            # which an unquoted join would split into separate argv entries and
            # silently drop.
            admix_pops         = " ".join(shlex.quote(p) for p in admixed_pops_list),
            # The spec crosses as one shell-quoted JSON object rather than a list of
            # names, because a composite group carries per-source individual counts
            # that cannot be space-joined. Kept a param rather than a spec file:
            # snakemake re-triggers on param changes, and writing a file at parse
            # time would fire on --dry-run and on every concurrent cluster job.
            reference_pops_arg = ("--reference_spec " + shlex.quote(json.dumps(reference_pops_spec))) if reference_pops_spec is not None else "",
            pops_arg           = ("--pops " + " ".join(shlex.quote(p) for p in pops_list)) if pops_list is not None else "",
            LAI_method         = LAI_method,
            # RFmix: parallelizing this step has been observed to be slower, not
            # faster. GNN/True are per-contig and do benefit from parallelism.
            num_threads        = 1 if LAI_method == "RFmix" else num_threads,
        shell:
            """
            mkdir -p {params.LAI_dir}
            python {input.script} \
                --input_path {params.input_path} \
                --LAI_path {params.LAI_dir} \
                --pop_labels {input.pop_labels} \
                --r {params.r} \
                --mu {params.mu} \
                --admix_pops {params.admix_pops} \
                {params.reference_pops_arg} \
                {params.pops_arg} \
                --LAI_method {params.LAI_method} \
                --num_threads {params.num_threads}
            """

    # Threshold-dependent sample selection: reads the genome-wide ancestry
    # proportions and writes one filtered pop_labels.csv per reference
    # population. Cheap, so re-running it on a threshold change costs nothing.
    checkpoint select_ancestry_samples:
        input:
            ancestry_proportions = ancestry_proportions,
            pop_labels           = pop_labels,
            pop_colors           = pop_colors,
            script               = select_ancestry_samples_script,
        output:
            ancestry_STT_dir = directory(ancestry_STT_path),
        params:
            LAI_dir    = LAI_path,
            admix_pops = " ".join(shlex.quote(p) for p in admixed_pops_list),
            threshold  = significant_ancestry_threshold,
        shell:
            """
            mkdir -p {output.ancestry_STT_dir}
            python {input.script} \
                --LAI_path {params.LAI_dir} \
                --ancestry_STT_path {output.ancestry_STT_dir} \
                --pop_labels {input.pop_labels} \
                --pop_colors {input.pop_colors} \
                --admix_pops {params.admix_pops} \
                --significant_ancestry_threshold {params.threshold}
            """

    # Re-globs the checkpoint's output directory to discover the realized
    # ancestry labels (unknown at parse time whenever reference_pops is None).
    def ancestry_labels_from_checkpoint(wildcards):
        ck_dir = checkpoints.select_ancestry_samples.get(**wildcards).output.ancestry_STT_dir
        return sorted(set(glob_wildcards(os.path.join(ck_dir, "{label}", "data", "pop_labels.csv")).label))

    compute_pdf_ancestry_flag = os.path.join(output_path, f"compute_pdf_ancestry_done.{LAI_method}.flag")

# # ______________________rates Rules_____________________
rule compute_pdf:
    input:
        main_script = COUNT_COAL_EVENTS_SCRIPT,
        script = compute_pdf_wrapper_script,
        pop_labels = pop_labels,
        trees_ready = trees_ready,
        # ancestry_STT_dir orders this rule after the select_ancestry_samples
        # checkpoint. LAI_dir is only listed when infer_local_ancestry produces it
        # — under LAI_method='True' it comes from simulate_trees.py and is no
        # rule's declared output, so requiring it here would fail the DAG on a
        # fresh run.
        **({"ancestry_STT_dir": ancestry_STT_path} if admix_mode else {}),
        **({"LAI_dir": LAI_path} if admix_mode and LAI_method != "True" else {})
    params:
        trees_dir = trees_dir,
        outdir = data_output_path,
        output_name = os.path.basename(pdf_data),
        pdf_min_time = pdf_min_time,
        pdf_max_time = pdf_max_time,
        pdf_bin_size = pdf_bin_size,
        fraction_samples = fraction_samples,
        num_threads = num_threads,
        admix_args = (f"--LAI_dir {LAI_path} --ancestry_STT_dir {ancestry_STT_path}" if admix_mode else "")

    output:
        pdf_data = pdf_data,
        # compute_pdf.py (admix mode) writes one pdf parquet per ancestry label
        # as a side effect of this same shell invocation, into subdirectories
        # whose names aren't known until the select_ancestry_samples checkpoint
        # has run. Snakemake 9.x doesn't support function-valued outputs, so
        # those per-label files can't be declared individually; this flag is
        # the real tracked output that downstream per-ancestry rules depend on
        # for ordering, while the actual per-label file path is resolved via
        # params (see ancestry_labels_from_checkpoint / *_ancestry rules below).
        ancestry_flag = touch(compute_pdf_ancestry_flag) if admix_mode else []
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.trees_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --pdf_min_time {params.pdf_min_time} \
            --pdf_max_time {params.pdf_max_time} \
            --pdf_bin_size {params.pdf_bin_size} \
            --fraction_samples {params.fraction_samples} \
            --pop_labels {input.pop_labels} \
            --num_threads {params.num_threads} \
            {params.admix_args}
        """

rule compute_rates:
    input:
        pdf_data = pdf_data,
        pop_labels = pop_labels,
        script = compute_rates_wrapper_script,
        main_script = COMPUTE_RATES_SCRIPT
    output:
        rates_data,
        weights_data
    params:
        outdir = data_output_path,
        output_name = rates_data_file_name,
        min_window_size = min_window_size,
        max_window_size = max_window_size,
        rates_min_time = rates_min_time,
        rates_max_time = rates_max_time,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_data} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --minimum_window_size {params.min_window_size} \
            --maximum_window_size {params.max_window_size} \
            --rates_min_time {params.rates_min_time} \
            --rates_max_time {params.rates_max_time} \
            --pop_labels {input.pop_labels} \
            {params.per_haplotype}
        """

rule plot_rates:
