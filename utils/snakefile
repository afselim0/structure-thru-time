import os
script_dir = os.path.dirname(os.path.abspath(__file__))
os.chdir(script_dir)
def read_config(parameter, default, params = config):
    return parameter if parameter in params else default

# =====================================================
# Input Parameters
# =====================================================

# General Parameters
ts_dir = read_config("ts_dir", default = None)
output_path = read_config("output_path", default = None)
num_threads = read_config("num_threads", default = 1)
version = read_config("version", default = 1)

# Simulation Parameters
demes_file_path = read_config("demes_file_path", default = None)
num_contigs = read_config("num_contigs", default = 500)
contig_length = read_config("contig_length", default = 1e6)
n_sim_per_pop = read_config("n_sim_per_pop", default = 20)
mutation_rate = read_config("mutation_rate", default = 1.2e-8)
recombination_rate = read_config("recombination_rate", default = 1.2e-8)

SIM_TAG = f".nC{num_contigs}.CL{contig_length}.NPP{n_sim_per_pop}"

# Inference Parameters
infer_method = read_config("infer_method", default = "tsinfer")
num_posterior_samples = read_config("num_replicates", default = 50)
thinning_interval = read_config("thinning_interval", default = 60)
burnin = read_config("burnin", default = 4000)

# Rate Inference Parameters
fraction_samples = read_config("fraction_samples", default = 1.0)
min_window_size = read_config("min_window_size", default = 50)
max_window_size = read_config("max_window_size", default = 500)
max_time = read_config("max_time", default = 10000)
num_timepoints = read_config("num_timepoints", default = 1000)

PDF_TAG = f".V{version}.FS{fraction_samples}.maxT{max_time}.nT{num_timepoints}"
RATES_TAG = f".minWS{min_window_size}.maxWS{max_window_size}" + PDF_TAG 

# STT Parameters 
N0 = read_config("N0", default = 1)
min_time = read_config("min_time", default = 1)
STT_TAG = f".N0{N0}" + RATES_TAG

# Empirical dataset parameters
pops = read_config("pops", "all").replace(","," ")
n_samples_per_pop = read_config("n_samples_per_pop", -1)
pop_colors = read_config("pop_colors", os.path.join(output_path,"data/pop_colors.csv"))
pop_labels = read_config("pop_labels", os.path.join(output_path,"data/pop_labels.csv"))

# Ensure parameters are provided
assert (demes_file_path is not None) or (ts_dir is not None), "Provide either path to demography to be simulated, or tree sequences to be analyzed"
assert output_path is not None, "Please specify output path"

# Main scripts
COUNT_COAL_EVENTS_SCRIPT = "../src/CountCoalEvents.py"
COMPUTE_RATES_SCRIPT = "../src/compute_coal_rates.py"
COMPUTE_EMBEDDINGS_SCRIPT = "../src/LatentSpaceEmbeddings.py"
PLOT_EMBEDDINGS_SCRIPT = "../src/PlotEmbeddings.py"

# Util Scripts
preprocess_demography_script = "preprocess_demography.py"
plot_demography_script = "plot_demography.py"
pca_script = "run_pca.py"
compute_rates_true_script = "compute_rates_true.py"

compute_pdf_wrapper_script = "compute_pdf.py"
compute_rates_wrapper_script = "compute_rates.py"
plot_rates_script = "plot_rates.py"
compute_embeedings_wrapper_script = "compute_embeddings.py"
plot_embeddings_wrapper_script = "plot_embeddings.py"
evaluate_performance_script = "evaluate_performance.py"

# =====================================================
# File Names
# =====================================================

# Base Output directories
data_output_path = os.path.join(output_path,"data")
plot_output_path = os.path.join(output_path,"plots")
tree_output_path = os.path.join(output_path,"trees")

# Target file names
pca_plot_file_name = "pca.png"
demography_plot_file_name = "demography.png"
rates_true_file_name = "rates_true.parquet"
rates_true_plot_file_name = "rates_true.png"
sim_finished_file_name = f"simulated{SIM_TAG}.txt"
infer_finished_file_name = f"inferred{SIM_TAG}.txt"

pdf_data_file_name = f"coal_pdf{PDF_TAG}.parquet"
rates_data_file_name = f"coal_pdf{RATES_TAG}.parquet"
rates_plot_file_name = f"coal_pdf{RATES_TAG}.png"

embeddings_data_file_name = f"embeddings{STT_TAG}.parquet"
embeddings_plot_file_name = f"embeddings{STT_TAG}.html"
performance_data_file_name = f"performance{STT_TAG}.parquet"
performance_plot_file_name = f"performance{STT_TAG}.png"

# Target file paths
pca_plot = os.path.join(plot_output_path,pca_plot_file_name)
demography_plot = os.path.join(plot_output_path,demography_plot_file_name)
rates_true = os.path.join(data_output_path,rates_true_file_name)
rates_true_plot = os.path.join(plot_output_path,rates_true_plot_file_name)
sim_finished = os.path.join(tree_output_path,sim_finished_file_name)
infer_finished = os.path.join(tree_output_path,infer_finished_file_name)

pdf_data = os.path.join(data_output_path,pdf_data_file_name)
rates_data = os.path.join(data_output_path,rates_data_file_name)
rates_plot = os.path.join(data_output_path,rates_plot_file_name)

embeddings_data = os.path.join(data_output_path,embeddings_data_file_name)
embeddings_plot = os.path.join(data_output_path,embeddings_plot_file_name)
performance_data = os.path.join(data_output_path,performance_data_file_name)
performance_plot = os.path.join(data_output_path,performance_plot_file_name)

combs_data_dir = os.path.join(output_path,"combs/data")
combs_plot_dir = os.path.join(output_path,"combs/plots")

# =====================================================
# Target Groups
# =====================================================

sim_targets = [
    pop_labels,pop_colors,pca_plot,demography_plot,
    rates_true,rates_true_plot, 
    sim_finished
    ]

rate_targets = [
    pdf_data,
    rates_data, rates_plot
    ]

STT_targets = [
    embeddings_data,
    embeddings_plot,
    performance_data,
    performance_plot
    ]

# =====================================================
# General Rules
# =====================================================
rule sim:
    input: sim_targets

rule infer:
    input: infer_finished

rule rates:
    input: rate_targets

rule STT: 
    input: STT_targets


rule STT_combs:
    input: 
        directory(combs_data_dir),
        directory(combs_plot_dir)
rule all_sim:
    sim_targets,infer_finished,rate_targets,STT_targets
rule all_empirical:
    rate_targets,STT_targets

# =====================================================
# Specific Rules
# =====================================================
# ______________________sim Rules______________________
rule preprocess_data:
    input:
        demes_file_path = demes_file_path,
        script = preprocess_demography_script
    output:
        pop_colors,
        pop_labels
    params:
        outdir = data_output_path,
        n_per_pop = n_sim_per_pop
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """
rule plot_demography:
    input:
        demes_file_path = demes_file_path,
        pop_colors = pop_colors,
        script = plot_demography_script
    output:
        demography_plot
    params:
        outdir = plot_output_path,
        max_time = max_time
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --output_path {params.outdir} \
            --max_time {params.max_time}
        """

rule run_pca:
    input:
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        demes_file_path = demes_file_path,
        script = pca_script
    output:
        pca_plot
    params:
        outdir = plot_output_path,
        n_per_pop = n_sim_per_pop
    shell:
        """
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --n {params.n_per_pop}
        """
rule compute_rates_true:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = compute_rates_true_script
    output:
        rates_true
    params:
        outdir = data_output_path,
        max_time = max_time
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --max_time {params.max_time} \
            --labels {input.pop_labels}
        """
rule plot_rates_true:
    input:
        rates = RATES_TRUE,
        pop_colors = POP_COLORS,
        pop_labels = POP_LABELS,
        script = plot_rates_script
    output:
        rates_true_plot
    params:
        outdir = plot_output_path,
        output_name = rates_true_plot_file_name
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """
# ______________________infer Rules_____________________
rule infer_trees:
    input:
        sim_finished = SIM_FINISHED,
        script="../../utils/infer_trees.py"
    output:
        INFER_FINISHED
    params:
        sim_tree_dir=SIM_TREE_OUTPUT_PATH,
        outdir=INFER_TREE_OUTPUT_PATH,
        output_name = INFER_FINISHED_FILE
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --sim_tree_path {params.sim_tree_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """
# ______________________rates Rules_____________________
rule compute_pdf:
    input:
        main_script = CountCoalEvents_SCRIPT,
        script = "../../utils/compute_pdf.py"
    params:
        trees_dir = trees_dir,
        outdir = data_output_path,
        output_name = os.path.basename(pdf_data),
        max_time = max_time,
        n_timepoints = n_timepoints,
        n_samples = n_samples,
        num_posterior_samples = num_posterior_samples,
        fraction_samples = fraction_samples,
        pops = pops,
        pop_labels = pop_labels,
        num_threads = num_threads

    output:
        pdf_data
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input_path {params.trees_dir} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
            --pops {params.pops} \
            --num_posterior_samples {params.num_posterior_samples} \
            --n_samples_per_pop {params.n_samples} \
            --fraction_samples {params.fraction_samples} \
            --pop_labels {params.pop_labels} \
            --num_threads {params.num_threads}
        """

rule compute_rates:
    input:
        pdf_data=pdf_data,
        script="../../utils/compute_rates.py",
        main_script=COMPUTE_RATES_SCRIPT
    output:
        rates_data
    params:
        outdir=data_output_path,
        output_name=os.path.basename(rates_data),
        min_window_size=min_window_size,
        max_window_size=max_window_size
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --pdf_path {input.pdf_data} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --minimum_window_size {params.min_window_size} \
            --maximum_window_size {params.max_window_size}
        """

rule plot_rates:
    input:
        rates=rates_data,
        pop_colors=pop_colors,
        pop_labels=pop_labels,
        script="../../utils/plot_rates.py"
    output:
        rates_plot
    params:
        outdir=plot_output_path,
        output_name=os.path.basename(rates_plot),
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name}
        """
# ______________________STT Rules_______________________
rule compute_embeddings:
    input:
        rates=rates_data,
        script="../../utils/compute_embeddings.py",
        main_script=COMPUTE_EMBEDDINGS_SCRIPT
    output:
        embeddings_data
    params:
        N0 = N0,
        outdir=data_output_path,
        output_name=os.path.basename(embeddings_data)
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.rates} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --N0 {params.N0}
        """
rule plot_embeddings:
    input:
        embeddings=embeddings_data,
        pop_colors=pop_colors,
        pop_labels=pop_labels,
        script="../../utils/plot_embeddings.py",
        main_script=PLOT_EMBEDDINGS_SCRIPT
    output:
        embeddings_3d_plot
    params:
        outdir=plot_output_path,
        output_name=os.path.basename(embeddings_3d_plot),
        min_time=min_time,
        # generation_time=generation_time
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --input {input.embeddings} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --output_name {params.output_name} \
            --min_time {params.min_time}
        """
rule evaluate_performance:
    input:
        embeddings=embeddings_data,
        rates=rates_data,
        pop_colors=pop_colors,
        pop_labels=pop_labels,
        script="../../utils/evaluate_performance.py"
    output:
        performance_data,
        performance_plot
    params:
        N0=N0,
        data_output_path=data_output_path,
        plot_output_path=plot_output_path,
        data_output_name=os.path.basename(performance_data),
        plot_output_name=os.path.basename(performance_plot)
    shell:
        """
        python {input.script} \
            --embeddings {input.embeddings} \
            --rates {input.rates} \
            --N0 {params.N0} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --data_output_path {params.data_output_path} \
            --plot_output_path {params.plot_output_path} \
            --data_output_name {params.data_output_name} \
            --plot_output_name {params.plot_output_name}
        """
rule population_combinations:
    input:
        pop_labels=pop_labels,
        pop_colors=pop_colors,
        rates=rates_data,
        script="../../utils/run_pop_combs.py"
    params:
        data_dir=combs_data_dir,
        plots_dir=combs_plots_dir,
        N0=N0,
        # generation_time=generation_time
    output:
        directory(combs_data_dir),
        directory(combs_plots_dir)
    shell:
        """
        python {input.script} \
            --data_dir {params.data_dir} \
            --plots_dir {params.plots_dir} \
            --pop_labels {input.pop_labels} \
            --pop_colors {input.pop_colors} \
            --rates_file {input.rates} \
            --N0 {params.N0}
        """