            pop_colors = pop_colors,
            pop_labels = pop_labels,
            script = evaluate_performance_script
        output:
            input_vs_reconstructed_rates_plot,
            input_vs_reconstructed_rates_interactive
        params:
            N_max = N_max,
            plot_output_path = plot_output_path,
            hist2d_output_name = input_vs_reconstructed_rates_plot_file_name,
            interactive_output_name = input_vs_reconstructed_rates_interactive_file_name,
            per_haplotype = "--per-haplotype" if per_haplotype else ""
        shell:
            """
            python {input.script} \
                --rates {input.rates} \
                --reconstructed_rates {input.reconstructed_rates} \
                --N_max {params.N_max} \
                --colors {input.pop_colors} \
                --labels {input.pop_labels} \
                --plot_output_path {params.plot_output_path} \
                --hist2d_output_name {params.hist2d_output_name} \
                --interactive_output_name {params.interactive_output_name} \
                {params.per_haplotype}
            """

# Smoothed performance evaluation: same as evaluate_performance but against the smoothed reconstructed
# rates. Same non-SS/SS split (true-rate comparison only available for simulated, non-SS demographies).
if smoothing_on:
    if demes_file_path and not is_SS_demography:
        rule evaluate_performance_smooth:
            input:
                rates = rates_data,
                reconstructed_rates = smooth_reconstructed_rates,
                true_rates = rates_true,
                pop_colors = pop_colors,
                pop_labels = pop_labels,
                script = evaluate_performance_script
            output:
                smooth_input_vs_reconstructed_rates_plot,
                smooth_input_vs_reconstructed_rates_interactive,
                smooth_true_rates_vs_reconstructed_rates_plot,
                smooth_true_rates_vs_reconstructed_rates_interactive
            params:
                N_max = N_max,
                plot_output_path = plot_output_path,
                hist2d_output_name = smooth_input_vs_reconstructed_rates_plot_file_name,
                interactive_output_name = smooth_input_vs_reconstructed_rates_interactive_file_name,
                true_hist2d_output_name = smooth_true_rates_vs_reconstructed_rates_plot_file_name,
                true_interactive_output_name = smooth_true_rates_vs_reconstructed_rates_interactive_file_name,
                per_haplotype = "--per-haplotype" if per_haplotype else ""
            shell:
                """
                python {input.script} \
                    --rates {input.rates} \
                    --reconstructed_rates {input.reconstructed_rates} \
                    --true_rates {input.true_rates} \
                    --N_max {params.N_max} \
                    --colors {input.pop_colors} \
                    --labels {input.pop_labels} \
                    --plot_output_path {params.plot_output_path} \
                    --hist2d_output_name {params.hist2d_output_name} \
                    --interactive_output_name {params.interactive_output_name} \
                    --true_hist2d_output_name {params.true_hist2d_output_name} \
                    --true_interactive_output_name {params.true_interactive_output_name} \
                    {params.per_haplotype}
                """
    else:
        rule evaluate_performance_smooth:
            input:
                rates = rates_data,
                reconstructed_rates = smooth_reconstructed_rates,
                pop_colors = pop_colors,
                pop_labels = pop_labels,
                script = evaluate_performance_script
            output:
                smooth_input_vs_reconstructed_rates_plot,
                smooth_input_vs_reconstructed_rates_interactive
            params:
                N_max = N_max,
                plot_output_path = plot_output_path,
                hist2d_output_name = smooth_input_vs_reconstructed_rates_plot_file_name,
                interactive_output_name = smooth_input_vs_reconstructed_rates_interactive_file_name,
                per_haplotype = "--per-haplotype" if per_haplotype else ""
            shell:
                """
                python {input.script} \
                    --rates {input.rates} \
                    --reconstructed_rates {input.reconstructed_rates} \
                    --N_max {params.N_max} \
                    --colors {input.pop_colors} \
                    --labels {input.pop_labels} \
                    --plot_output_path {params.plot_output_path} \
                    --hist2d_output_name {params.hist2d_output_name} \
                    --interactive_output_name {params.interactive_output_name} \
                    {params.per_haplotype}
                """

# ______________________scan Rules______________________
if scan_p_mode: # Scan the exponent p over a grid, holding n_components fixed
    rule scan_p:
        input:
            rates = rates_data,
            script = scan_p_script,
            main_script = COMPUTE_EMBEDDINGS_SCRIPT,
            support_script = OPTIMIZATION_FUNCTIONS_SCRIPT
        output:
            scan_p_output
        params:
            min_p = min_p,
            max_p = max_p,
            num_p = num_p,
            N_min = N_min,
            N_max = N_max,
            link = link,
            n_components = n_components,
            n_timepoints_emb = n_timepoints_emb,
            outdir = scan_p_outdir,
            true_rates_arg = f"--true_rates {rates_true}" if demes_file_path and not is_SS_demography else "",
            per_haplotype = "--per-haplotype" if per_haplotype else ""
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --rates {input.rates} \
                --output_path {params.outdir} \
                --output {output} \
                --min_p {params.min_p} \
                --max_p {params.max_p} \
                --num_p {params.num_p} \
                --N_min {params.N_min} \
                --N_max {params.N_max} \
                --link {params.link} \
                --n_components {params.n_components} \
                --n_timepoints_emb {params.n_timepoints_emb} \
                {params.true_rates_arg} \
                {params.per_haplotype}
            """

