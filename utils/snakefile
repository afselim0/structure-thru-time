# ______________________ancestry-specific STT Rules________________________
# Repeats the STT rules above once per reference/ancestry population label,
# rooted at {ancestry_STT_path}/{ancestry}/data and .../plots instead of
# data_output_path/plot_output_path. Ancestry labels are only known once the
# select_ancestry_samples checkpoint has run (reference_pops may be None in
# config, defaulted internally by infer_local_ancestry.py), so these are
# plain wildcard rules driven by the aggregator function/sentinel rule below.
if admix_mode:
    def ancestry_data_dir(ancestry):  return os.path.join(ancestry_STT_path, ancestry, "data")
    def ancestry_plot_dir(ancestry):  return os.path.join(ancestry_STT_path, ancestry, "plots")

    rule compute_rates_ancestry:
        input:
            ancestry_flag = compute_pdf_ancestry_flag,
            pop_labels = os.path.join(ancestry_STT_path, "{ancestry}", "data", "pop_labels.csv"),
            script = compute_rates_wrapper_script,
