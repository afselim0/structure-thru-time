import os
from pathlib import Path
from itertools import combinations
def read_config(parameter, default, params = config):
    return config[parameter] if parameter in params else default

# =====================================================
# Input Parameters (from config)
# =====================================================

# General Parameters
output_path                       = read_config("output_path", default = "../results")
tree_output_path                  = os.path.join(output_path,"trees") # This directory is used when trees are simulated or inferred from simulated trees
trees_dir                         = read_config("trees_dir", default = tree_output_path) # Default is the output path of simulated/inferred trees, unless trees are already inferred
num_threads                       = read_config("num_threads", default = 1) # Parallelization used in simulation, inference and computation of coalescent pdf
version                           = read_config("version", default = 1)

# Simulation Parameters
demes_file_path                   = read_config("demes_file_path", default = "")
is_SS_demography              = "SS" in os.path.basename(demes_file_path) # Spatial (SS) demographies: no demography plot, no true rates
num_contigs                       = int(read_config("num_contigs", default = 500))
contig_length                     = int(read_config("contig_length", default = 5e6))
n_sim_per_pop                     = read_config("n_sim_per_pop", default = 20)
mutation_rate                     = read_config("mutation_rate", default = 1.2e-8)
recombination_rate                = read_config("recombination_rate", default = 1.2e-8)

# Inference Parameters
infer_method                      = read_config("infer_method", default = "None")
num_posterior_samples             = read_config("num_posterior_samples", default = 1)
thinning_interval                 = read_config("thinning_interval", default = 60)
burnin                            = read_config("burnin", default = 4000)
vcf_dir                           = read_config("vcf_dir", default=tree_output_path.replace(infer_method,"sim"))

# Rate Inference Parameters
fraction_samples                  = read_config("fraction_samples", default = 1.0)   # Fraction of samples taken into account in pdf computation at each contig
min_window_size                   = read_config("min_window_size", default = 50)    # Window size for local linear regression at t=0
max_window_size                   = read_config("max_window_size", default = 500)   # Window size for local linear regression at t=max_time
max_time                          = read_config("max_time", default = 10000)
n_timepoints                      = read_config("n_timepoints", default = max_time)
per_haplotype                     = str(read_config("per_haplotype", default = "False")).lower() == "true" # If True, coalescent rates (and embeddings, plots) are per-haplotype rather than per-individual
compute_variance                  = str(read_config("compute_variance", default = "True")).lower() == "true" # If True, pass --compute_variance to compute_coal_rates to estimate standard errors of rates

# STT Parameters
N_min                             = read_config("N_min", default = 1)
N_max                             = read_config("N_max", default = N_min + 100000)
p                                 = read_config("p", default = 1)
link                              = read_config("link", default = "inverse_distance")
l1_penalties                      = read_config("l1", default = "None")
l2_penalties                      = read_config("l2", default = "None")
n_components                      = read_config("n_components", default = 2) 
rates_time_stride                 = read_config("rates_time_stride", default = "auto") # dash bundle: thin rate-parquet timepoints ("auto"|N|1)
if isinstance(l1_penalties, list): l1_penalties = ",".join(str(x) for x in l1_penalties)
if isinstance(l2_penalties, list): l2_penalties = ",".join(str(x) for x in l2_penalties)

# Plotting parameters
min_time                          = read_config("min_time", default = 1) # For plotting purposes only
n_timepoints_emb                  = read_config("n_timepoints_emb", default = n_timepoints) # For plotting purposes only
embeddings_plot_lims              = read_config("embeddings_plot_lims", default="None") 
max_rate_plot                     = read_config("max_rate_plot", default = 1/10000)
embeddings_max_time               = read_config("embeddings_max_time", default = max_time)
time_scale                        = read_config("time_scale", default = "linear")

# Empirical dataset parameters
pops                              = read_config("pops", "all").replace(","," ")
n_samples_per_pop                 = read_config("n_samples_per_pop", -1)
subsample_seed                    = read_config("subsample_seed", default = 0) # Seed for random subsampling in preprocess_samples (empirical runs only)
# raw_pop_colors/raw_pop_labels are the user-supplied metadata files for empirical runs (unused in simulation mode).
# pop_colors/pop_labels always point at the run-local, already-sliced copies that downstream rules consume.
raw_pop_colors                    = read_config("pop_colors", default = "")
raw_pop_labels                    = read_config("pop_labels", default = "")
pop_colors                        = os.path.join(output_path, "data/pop_colors.csv")
pop_labels                        = os.path.join(output_path, "data/pop_labels.csv")

# Admixture Parameters
admixed_pops                      = read_config("admixed_pops", default=None)
reference_pops                    = read_config("reference_pops", default=None)
significant_ancestry_threshold    = read_config("significant_ancestry_threshold", default=0.05)

def _to_list(x):
    if x is None: return None
    if isinstance(x, list): return [str(v).strip() for v in x]
    return [v.strip() for v in str(x).replace(",", " ").split() if v.strip()]

admixed_pops_list   = _to_list(admixed_pops)
reference_pops_list = _to_list(reference_pops)   # stays None if unspecified — infer_local_ancestry.py defaults it at runtime
admix_mode          = admixed_pops_list is not None and len(admixed_pops_list) > 0
pops_list           = None if pops == "all" else pops.split()   # reuse existing `pops` var (already space-joined)

if admix_mode and pops_list is not None:
    _bad_admixed = [p for p in admixed_pops_list if p not in pops_list]
    if _bad_admixed:
        raise ValueError(f"admixed_pops {_bad_admixed} not in pops={pops_list}; admixed_pops must be a subset of pops.")
    if reference_pops_list is not None:
        _bad_ref = [p for p in reference_pops_list if p not in pops_list]
        if _bad_ref:
            raise ValueError(f"reference_pops {_bad_ref} not in pops={pops_list}; reference_pops must be a subset of pops.")
    # if reference_pops_list is None, the subset restriction is deferred to infer_local_ancestry.py via --pops

# Replicate optimization seeds (optional; used only by compute_embeddings_replicates rule)
seeds                             = read_config("seeds", default = [])

# Scan Parameters (optional; scan_p/scan_d rules only activate if their respective config keys are all present)
min_p                             = read_config("min_p", default=None)
max_p                             = read_config("max_p", default=None)
num_p                             = read_config("num_p", default=None)
min_d                             = read_config("min_d", default=None)
max_d                             = read_config("max_d", default=None)
num_d                             = read_config("num_d", default=None)
scan_p_mode                       = min_p is not None and max_p is not None and num_p is not None
scan_d_mode                       = min_d is not None and max_d is not None and num_d is not None

# Parameter label for plot titles (optional — pass to --param_label in plotting rules)
_l1_str = f" | l1={l1_penalties}" if l1_penalties != "None" else ""
_l2_str = f" | l2={l2_penalties}" if l2_penalties != "None" else ""
param_label = (
    f"n={n_samples_per_pop}/pop | "
    f"N=[{N_min}, {N_max}] | "
    f"link={link} | "
    f"window size=[{min_window_size}, {max_window_size}]"
    f"{_l1_str}{_l2_str}"
)

# Filename Tags
SIM_TAG                           = f".NC{num_contigs}.CL{contig_length}.NPP{n_sim_per_pop}"
PDF_TAG                           = f".V{version}.FS{fraction_samples}.maxT{max_time}.nT{n_timepoints}"
RATES_TAG                         = f".minWS{min_window_size}.maxWS{max_window_size}" + PDF_TAG
STT_TAG                           = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.p{p}.link{link}.L1[{l1_penalties}].L2[{l2_penalties}].nTe{n_timepoints_emb}" + RATES_TAG
PLOT_TAG                          = f".minTPlot{min_time}.maxTPlot{embeddings_max_time}.xylims{embeddings_plot_lims}" + STT_TAG
TRUE_TAG                          = f".d{n_components}.Nmin{N_min}.Nmax{N_max}" + STT_TAG
# STT_TAG with the swept field omitted, for use by the scan_p/scan_d rules (the value varies within the rule, so it can't appear in a single output filename)
STT_TAG_NO_P                      = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.link{link}.L1[{l1_penalties}].L2[{l2_penalties}].nTe{n_timepoints_emb}" + RATES_TAG
STT_TAG_NO_D                      = f".Nmin{N_min}.Nmax{N_max}.p{p}.link{link}.L1[{l1_penalties}].L2[{l2_penalties}].nTe{n_timepoints_emb}" + RATES_TAG

# Main scripts
COUNT_COAL_EVENTS_SCRIPT          = "../src/CountCoalEvents.py"
COMPUTE_RATES_SCRIPT              = "../src/ComputeCoalescentRates.py"
COMPUTE_EMBEDDINGS_SCRIPT         = "../src/LatentSpaceEmbeddings.py"
OPTIMIZATION_FUNCTIONS_SCRIPT     = "../src/OptimzationFunctions.py"
PLOT_EMBEDDINGS_SCRIPT            = "../src/PlotEmbeddings.py"
PLOT_EMBEDDINGS_PYVISTA_SCRIPT    = "../src/PlotEmbeddingsPyVista.py"

# Util Scripts
preprocess_demography_script           = "preprocess_demography.py"
preprocess_samples_script              = "preprocess_samples.py"
plot_demography_script                 = "plot_demography.py"
pca_script                             = "run_pca.py"
compute_rates_true_script              = "compute_rates_true.py"
simulate_trees_script                  = "simulate_trees.py"
infer_trees_script                     = "infer_trees.py"
compute_pdf_wrapper_script             = "compute_pdf.py"
infer_local_ancestry_script            = "infer_local_ancestry.py"
compute_rates_wrapper_script           = "compute_rates.py"
plot_rates_script                      = "plot_rates.py"
plot_relative_div_script               = "plot_relative_div.py"
compute_embeddings_wrapper_script      = "compute_embeddings.py"
plot_embeddings_wrapper_script         = "plot_embeddings.py"
plot_embeddings_pyvista_wrapper_script = "plot_embeddings_pyvista.py"
evaluate_performance_script            = "evaluate_performance.py"
scan_p_script                          = "scan_p.py"
scan_d_script                          = "scan_d.py"
run_population_combs_script            = "run_pop_combs.py"
bundle_dash_script                     = "bundle_dash.py"
dash_app_script                        = "plot_embeddings_dash.py"

# =====================================================
# File Names
# =====================================================
# Base Output directories
data_output_path                       = os.path.join(output_path, "data")
plot_output_path                       = os.path.join(output_path, "plots")
LAI_path                                = os.path.join(output_path, "LAI")
ancestry_STT_path                       = os.path.join(output_path, "ancestry_STT")

# Target file names
pca_plot_file_name                                      = "pca.png"
demography_plot_file_name                               = "demography.png"
rates_true_file_name                                    = "rates_true.parquet"
rates_true_plot_file_name                               = "rates_true.png"
embeddings_true_file_name                               = f"embeddings_true{TRUE_TAG}.parquet"
embeddings_true_plot_file_name                          = f"embeddings_true{TRUE_TAG}.html"
reconstructed_rates_true_file_name                      = f"reconstructed_rates_true{TRUE_TAG}.parquet"
input_vs_reconstructed_rates_true_plot_file_name        = f"input_vs_reconstructed_rates_true{TRUE_TAG}.png"
input_vs_reconstructed_rates_true_interactive_file_name = f"input_vs_reconstructed_rates_true{TRUE_TAG}.html"
sim_finished_file_name                                  = f"sim_trees_ready{SIM_TAG}.txt"
infer_finished_file_name                                = f"infer_trees_ready{SIM_TAG}.txt"

if trees_dir == tree_output_path: # The case of simulation or inference
    if infer_method == "None": # Simulation
        trees_ready = sim_finished_file_name
    else: # Inference
        trees_ready = infer_finished_file_name
else: # The case of using empirical trees
    trees_ready = "trees_ready.txt"

trees_ready                            = os.path.join(trees_dir, trees_ready)

pdf_data_file_name                     = f"coal_pdf{PDF_TAG}.parquet"
rates_data_file_name                   = f"rates{RATES_TAG}.parquet"
rates_plot_file_name                   = f"rates{RATES_TAG}.png"
relative_div_plot_file_name            = f"relative_div{RATES_TAG}.png"
relative_div_plot_summary_file_name    = f"relative_div{RATES_TAG}_summary.png"

embeddings_data_file_name                                = f"embeddings{STT_TAG}.parquet"
embeddings_plot_file_name                                = f"embeddings{PLOT_TAG}.html"
reconstructed_rates_file_name                            = f"reconstructed_rates{STT_TAG}.parquet"
input_vs_reconstructed_rates_plot_file_name             = f"input_vs_reconstructed_rates{STT_TAG}.png"
input_vs_reconstructed_rates_interactive_file_name      = f"input_vs_reconstructed_rates{STT_TAG}.html"
true_rates_vs_reconstructed_rates_plot_file_name        = f"true_rates_vs_reconstructed_rates{STT_TAG}.png"
true_rates_vs_reconstructed_rates_interactive_file_name = f"true_rates_vs_reconstructed_rates{STT_TAG}.html"
embeddings_pyvista_plot_file_name                        = f"embeddings_pyvista{PLOT_TAG}.html"
dash_launch_file_name                                    = f"launch_dash{STT_TAG}.sh"
dash_launch_true_file_name                               = f"launch_dash_true.Nmin{N_min}.Nmax{N_max}.sh"
dash_bundle_file_name                                    = f"dash_bundle{STT_TAG}.zip"

# Scan diagnostics file names (one row per swept value, per rates comparison)
scan_p_file_name                                          = f"scan_p{STT_TAG_NO_P}.csv"
scan_d_file_name                                          = f"scan_d{STT_TAG_NO_D}.csv"

# Target file paths
pca_plot                          = os.path.join(plot_output_path, pca_plot_file_name)
demography_plot                   = os.path.join(plot_output_path, demography_plot_file_name)
rates_true                        = os.path.join(data_output_path, rates_true_file_name)
rates_true_plot                   = os.path.join(plot_output_path, rates_true_plot_file_name)
embeddings_true                   = os.path.join(data_output_path, embeddings_true_file_name)
embeddings_true_plot              = os.path.join(plot_output_path, embeddings_true_plot_file_name)
reconstructed_rates_true             = os.path.join(data_output_path, reconstructed_rates_true_file_name)
input_vs_reconstructed_rates_true_plot             = os.path.join(plot_output_path, input_vs_reconstructed_rates_true_plot_file_name)
input_vs_reconstructed_rates_true_interactive      = os.path.join(plot_output_path, input_vs_reconstructed_rates_true_interactive_file_name)
sim_finished                      = os.path.join(tree_output_path, sim_finished_file_name)
infer_finished                    = os.path.join(tree_output_path, infer_finished_file_name)

pdf_data                          = os.path.join(data_output_path, pdf_data_file_name)
rates_data                        = os.path.join(data_output_path, rates_data_file_name)
rates_plot                        = os.path.join(plot_output_path, rates_plot_file_name)
relative_div_plot                 = os.path.join(plot_output_path, relative_div_plot_file_name)
relative_div_plot_summary         = os.path.join(plot_output_path, relative_div_plot_summary_file_name)

embeddings_data                   = os.path.join(data_output_path, embeddings_data_file_name)
embeddings_plot                   = os.path.join(plot_output_path, embeddings_plot_file_name)
slice_2d_file_name                = f"2d_slice{PLOT_TAG}.png"
slice_2d                          = os.path.join(plot_output_path, slice_2d_file_name)
reconstructed_rates                  = os.path.join(data_output_path, reconstructed_rates_file_name)
input_vs_reconstructed_rates_plot                  = os.path.join(plot_output_path, input_vs_reconstructed_rates_plot_file_name)
input_vs_reconstructed_rates_interactive           = os.path.join(plot_output_path, input_vs_reconstructed_rates_interactive_file_name)
true_rates_vs_reconstructed_rates_plot             = os.path.join(plot_output_path, true_rates_vs_reconstructed_rates_plot_file_name)
true_rates_vs_reconstructed_rates_interactive      = os.path.join(plot_output_path, true_rates_vs_reconstructed_rates_interactive_file_name)
embeddings_pyvista_plot           = os.path.join(plot_output_path, embeddings_pyvista_plot_file_name)
dash_launch                       = os.path.join(plot_output_path, dash_launch_file_name)
dash_launch_true                  = os.path.join(plot_output_path, dash_launch_true_file_name)
dash_bundle                       = os.path.join(plot_output_path, dash_bundle_file_name)
scan_p_output                     = os.path.join(data_output_path, scan_p_file_name)
scan_d_output                     = os.path.join(data_output_path, scan_d_file_name)
scan_p_outdir                     = os.path.join(data_output_path, "scan_p")
scan_d_outdir                     = os.path.join(data_output_path, "scan_d")

# Replicate embeddings file names (one per seed)
embeddings_replicate_data              = [os.path.join(data_output_path, f"embeddings_seed{s}{STT_TAG}.parquet") for s in seeds]
replicates_panel_file_name             = f"replicates_panel{PLOT_TAG}.png"
replicates_panel                       = os.path.join(plot_output_path, replicates_panel_file_name)
replicates_2d_slice_file_name          = f"replicates_2d_slice{PLOT_TAG}.png"
replicates_2d_slice                    = os.path.join(plot_output_path, replicates_2d_slice_file_name)
replicates_ggpairs_file_name           = f"replicates_ggpairs{PLOT_TAG}.png"
replicates_ggpairs                     = os.path.join(plot_output_path, replicates_ggpairs_file_name)
replicates_performance_panel_file_name = f"replicates_performance_panel{PLOT_TAG}.png"
replicates_performance_panel           = os.path.join(plot_output_path, replicates_performance_panel_file_name)

# Pairwise rates comparison plots between replicates (all ordered pairs i < j)
replicate_comparison_plots        = [
    f
    for sa, sb in combinations(seeds, 2)
    for f in [
        os.path.join(plot_output_path, f"rates_comparison_seed{sa}_vs_seed{sb}{PLOT_TAG}.png"),
        os.path.join(plot_output_path, f"rates_comparison_seed{sa}_vs_seed{sb}{PLOT_TAG}.html"),
    ]
]

if trees_dir != tree_output_path and not os.path.exists(trees_ready): # In the case of using trees inferred from empirical data, create the trees ready file
    Path(trees_ready).touch()

# =====================================================
# Target Groups
# =====================================================
true_targets = [pop_labels, pop_colors]
if not is_SS_demography: # True coalescence rates are not computable for SS (stepping-stone) demographies
    true_targets = true_targets + [
        rates_true, rates_true_plot,
        embeddings_true, embeddings_true_plot,
        reconstructed_rates_true, input_vs_reconstructed_rates_true_plot, input_vs_reconstructed_rates_true_interactive,
        dash_launch_true]

sim_targets = [sim_finished] + ([] if is_SS_demography else [demography_plot])

STT_targets = [
    pdf_data,
    rates_data, rates_plot,
    embeddings_data, embeddings_plot,
    slice_2d,
    reconstructed_rates, input_vs_reconstructed_rates_plot, input_vs_reconstructed_rates_interactive,
    dash_launch,
    ]

if demes_file_path and not is_SS_demography: # Ground-truth demographic rates are only available for simulated, non-SS demographies
    STT_targets = STT_targets + [rates_true, true_rates_vs_reconstructed_rates_plot, true_rates_vs_reconstructed_rates_interactive]

if not is_SS_demography: # Relative divergence plot is not applicable to stepping-stone simulations
    STT_targets = STT_targets + [relative_div_plot, relative_div_plot_summary]

if admix_mode:
    STT_targets = STT_targets + [os.path.join(output_path, "ancestry_STT_done.flag")]

if scan_p_mode:
    STT_targets = STT_targets + [scan_p_output]

if scan_d_mode:
    STT_targets = STT_targets + [scan_d_output]

replicates_targets = ([rates_data]
                      + embeddings_replicate_data
                      + ([replicates_panel]                  if seeds else [])
                      + ([replicates_2d_slice]               if seeds else [])
                      + ([replicates_ggpairs]                if len(seeds) > 1 else [])
                      + ([replicates_performance_panel]      if seeds else []))

# =====================================================
# General Rules
# =====================================================
rule STT_true:# Compute true rates, embeddings, and performance without simulating trees
    input: true_targets

rule sim: # Compute true targets and simulate the trees
    input: sim_targets
rule STT_sim: # Simulate and run STT on simulated trees
    input: sim_targets, STT_targets

rule infer: # Only infer the trees 
    input: infer_finished
rule STT_infer: # Infer and run STT on inferred trees
    input: infer_finished, STT_targets

rule STT: # Run STT
    input: STT_targets

rule STT_replicates: # Run multiple replicate optimizations with different seeds (rates computed once)
    input: replicates_targets

# =====================================================
# Specific Rules
# =====================================================

# ______________________sim Rules______________________
if demes_file_path: # A demes file path is specified
    rule preprocess_data:
        input:
            demes_file_path = demes_file_path,
            script = preprocess_demography_script
        output:
            pop_colors,
            pop_labels
        params:
            outdir = data_output_path,
            n_per_pop = n_sim_per_pop
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --demes_file_path {input.demes_file_path} \
                --output_path {params.outdir} \
                --n {params.n_per_pop}
            """
    rule plot_demography:
        input:
            demes_file_path = demes_file_path,
            pop_colors = pop_colors,
            script = plot_demography_script
        output:
            demography_plot
        params:
            outdir = plot_output_path,
            min_time = min_time,
            max_time = max_time,
            time_scale = time_scale
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --demes_file_path {input.demes_file_path} \
                --colors {input.pop_colors} \
                --output_path {params.outdir} \
                --min_time {params.min_time} \
                --max_time {params.max_time} \
                --time_scale {params.time_scale}
            """
else: # No demes file path: this is an empirical run, slice the user-supplied pop_labels/pop_colors instead
    if not raw_pop_labels or not raw_pop_colors:
        raise ValueError("pop_labels and pop_colors must be specified in the config when demes_file_path is not provided (empirical run).")
    rule preprocess_data:
        input:
            pop_labels = raw_pop_labels,
            pop_colors = raw_pop_colors,
            script = preprocess_samples_script
        output:
            pop_colors,
            pop_labels
        params:
            outdir = data_output_path,
            pops = pops,
            n_samples_per_pop = n_samples_per_pop,
            seed = subsample_seed
        shell:
            """
            mkdir -p {params.outdir}
            python {input.script} \
                --pop_labels {input.pop_labels} \
                --pop_colors {input.pop_colors} \
                --output_path {params.outdir} \
                --pops {params.pops} \
                --n_samples_per_pop {params.n_samples_per_pop} \
                --seed {params.seed}
            """

rule run_pca:
    input:
        pop_colors = pop_colors,
        pop_labels = pop_labels,
        demes_file_path = demes_file_path,
        script = pca_script
    output:
        pca_plot
    params:
        outdir = plot_output_path,
        n_per_pop = n_sim_per_pop,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --colors {input.pop_colors} \
            --labels {input.pop_labels} \
            --output_path {params.outdir} \
            --n {params.n_per_pop} \
            {params.per_haplotype}
        """

rule compute_rates_true:
    input:
        demes_file_path = demes_file_path,
        pop_labels = pop_labels,
        script = compute_rates_true_script
    output:
        rates_true
    params:
        outdir = data_output_path,
        max_time = max_time,
        n_timepoints = n_timepoints,
        per_haplotype = "--per-haplotype" if per_haplotype else ""
    shell:
        """
        mkdir -p {params.outdir}
        python {input.script} \
            --demes_file_path {input.demes_file_path} \
            --output_path {params.outdir} \
            --max_time {params.max_time} \
            --n_timepoints {params.n_timepoints} \
