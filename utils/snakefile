import json
import math
import os
import re
import shlex
from pathlib import Path
from itertools import combinations
def read_config(parameter, default, params = config):
    return config[parameter] if parameter in params else default

# =====================================================
# Input Parameters (from config)
# =====================================================

# General Parameters
output_path                       = read_config("output_path", default = "../results")
tree_output_path                  = os.path.join(output_path,"trees") # This directory is used when trees are simulated or inferred from simulated trees
trees_dir                         = read_config("trees_dir", default = tree_output_path) # Default is the output path of simulated/inferred trees, unless trees are already inferred
num_threads                       = read_config("num_threads", default = 1) # Parallelization used in simulation, inference and computation of coalescent pdf
version                           = read_config("version", default = 1)

# Simulation Parameters
demes_file_path                   = read_config("demes_file_path", default = "")
is_SS_demography                  = "SS" in os.path.basename(demes_file_path) # Spatial (SS) demographies: no demography plot, no true rates
num_contigs                       = int(read_config("num_contigs", default = 500))
contig_length                     = int(read_config("contig_length", default = 5e6))
n_sim_per_pop                     = read_config("n_sim_per_pop", default = 20)
mutation_rate                     = read_config("mutation_rate", default = 1.2e-8)
recombination_rate                = read_config("recombination_rate", default = 1.2e-8)

# Inference Parameters
infer_method                      = read_config("infer_method", default = "None")
thinning_interval                 = read_config("thinning_interval", default = 20)   # SINGER: -thin
burnin                            = read_config("burnin", default = 1000)            # SINGER: total burn-in iterations
singer_polegon                    = str(read_config("singer_polegon", default = "True")).lower() == "true" # SINGER: re-date the retained draw with POLEGON
num_infer_contigs                 = int(read_config("num_infer_contigs", default = num_contigs)) # Number of simulated contigs to infer trees for
sim_trees_dir                     = read_config("sim_trees_dir", default=tree_output_path.replace(infer_method,"sim"))

# Rate Inference Parameters
fraction_samples                  = read_config("fraction_samples", default = 1.0)   # Fraction of samples taken into account in pdf computation at each contig

# --- Coalescent-time PDF grid -------------------------------------------------
# The pdf is the expensive product, and one pdf supports many cheap rate slices,
# so its extent is specified independently of the interval rates are wanted on.
# Columns are the bin LEFT edges pdf_min_time, +bin, ..., pdf_max_time INCLUSIVE;
# column t holds the coalescent mass in [t, t + pdf_bin_size).
_REMOVED_TIME_KEYS = {
    "max_time":     "replaced by pdf_max_time; set pdf_bin_size = old max_time / old n_timepoints",
    "n_timepoints": "removed; set pdf_bin_size = old max_time / old n_timepoints instead",
    "min_time":     "renamed to embeddings_min_time (it was always plotting-only)",
}
_stale_time_keys = [k for k in _REMOVED_TIME_KEYS if k in config]
if _stale_time_keys:
    raise ValueError(
        "Config uses removed time keys: "
        + "; ".join(f"{k!r} ({_REMOVED_TIME_KEYS[k]})" for k in _stale_time_keys)
        + ". See data/configs/ for migrated examples."
    )

pdf_min_time                      = read_config("pdf_min_time", default = 0)
pdf_max_time                      = read_config("pdf_max_time", default = 10000)
pdf_bin_size                      = read_config("pdf_bin_size", default = 1)

if pdf_min_time != 0:
    raise NotImplementedError(
        f"pdf_min_time={pdf_min_time} is not supported yet (only 0). The survival "
        "S = 1 - cumsum(pdf) would be missing the coalescent mass in "
        f"[0, {pdf_min_time}), so the survival -- and every rate derived from it -- "
        "would be wrong. The parameter exists and is carried in filenames so the "
        "grid is self-describing, but a nonzero value must be implemented first."
    )
if pdf_bin_size <= 0:
    raise ValueError(f"pdf_bin_size must be positive (got {pdf_bin_size}).")
if pdf_max_time <= pdf_min_time:
    raise ValueError(f"pdf_max_time ({pdf_max_time}) must exceed pdf_min_time ({pdf_min_time}).")
_pdf_span = pdf_max_time - pdf_min_time
_n_pdf_bins = round(_pdf_span / pdf_bin_size)
if abs(_n_pdf_bins * pdf_bin_size - _pdf_span) > 1e-9 * max(1.0, abs(_pdf_span)):
    raise ValueError(
        f"(pdf_max_time - pdf_min_time) = {_pdf_span} is not an exact multiple of "
        f"pdf_bin_size = {pdf_bin_size} (would need {_pdf_span / pdf_bin_size} bins). "
        "Choose a bin size that divides the span exactly."
    )
n_pdf_timepoints                  = _n_pdf_bins + 1   # inclusive of pdf_max_time

# --- Rate estimation interval -------------------------------------------------
# min_window_size is the local-linear bandwidth AT rates_min_time and
# max_window_size the bandwidth AT rates_max_time. compute_rates pads the pdf
# slice beyond this interval before filtering and clips the pad off afterwards,
# so every saved timepoint is an interior (symmetric-window) row rather than a
# constant-rate artefact of where the grid stops.
rates_min_time                    = read_config("rates_min_time", default = pdf_min_time)
rates_max_time                    = read_config("rates_max_time", default = pdf_max_time)
min_window_size                   = read_config("min_window_size", default = 50)    # bandwidth at rates_min_time
max_window_size                   = read_config("max_window_size", default = 500)   # bandwidth at rates_max_time

def _snap_to_pdf_grid(value, name):
    """Round a rate bound up onto the pdf grid, reporting any move.

    The rate interval is a slice of the pdf's columns, so its bounds have to be
    pdf timepoints. Rather than rejecting a bound that falls between two columns,
    it is rounded UP to the next one: that is the nearest grid point which does
    not ask for rates outside the requested interval. The move is at most one bin
    and is printed, because it silently changes the filename tag (and so which
    outputs a run reuses).
    """
    steps = (value - pdf_min_time) / pdf_bin_size
    if abs(steps - round(steps)) <= 1e-9 * max(1.0, abs(steps)):
        return value
    snapped = pdf_min_time + math.ceil(steps - 1e-9) * pdf_bin_size
    # Rounding up grows the interval at the old end, which can walk off the grid;
    # step back one bin there rather than leave the pdf.
    if snapped > pdf_max_time:
        snapped -= pdf_bin_size
    print(f"note: {name}={value} is not on the pdf grid (pdf_min_time={pdf_min_time}, "
          f"pdf_bin_size={pdf_bin_size}); using {snapped}.")
    return snapped

rates_min_time                    = _snap_to_pdf_grid(rates_min_time, "rates_min_time")
rates_max_time                    = _snap_to_pdf_grid(rates_max_time, "rates_max_time")

if not (pdf_min_time <= rates_min_time < rates_max_time <= pdf_max_time):
    raise ValueError(
        f"the rates interval [{rates_min_time}, {rates_max_time}] must be a non-empty "
        f"sub-interval of the pdf grid [{pdf_min_time}, {pdf_max_time}]."
    )
n_rates_timepoints                = round((rates_max_time - rates_min_time) / pdf_bin_size) + 1
per_haplotype                     = str(read_config("per_haplotype", default = "False")).lower() == "true" # If True, coalescent rates (and embeddings, plots) are per-haplotype rather than per-individual

# STT Parameters
N_min                             = read_config("N_min", default = 1)
N_max                             = read_config("N_max", default = N_min + 100000)
p                                 = read_config("p", default = 1)
link                              = read_config("link", default = "inverse_distance")
l1_penalties                      = read_config("l1", default = "None")
n_components                      = read_config("n_components", default = 2) 
unweighted                        = str(read_config("unweighted", default = "True")).lower() == "true" # Weight every pair equally in both optimization stages, ignoring the loss weights entirely
rates_time_stride                 = read_config("rates_time_stride", default = "auto") # dash bundle: thin rate-parquet timepoints ("auto"|N|1)
if isinstance(l1_penalties, list): l1_penalties = ",".join(str(x) for x in l1_penalties)

# Plotting parameters
embeddings_min_time               = read_config("embeddings_min_time", default = rates_min_time) # For plotting purposes only; defaults to the shallowest timepoint the rates actually carry
n_timepoints_emb                  = read_config("n_timepoints_emb", default = n_rates_timepoints) # Timepoints the embeddings are solved on (both stages); defaults to every rate timepoint
embeddings_plot_lims              = read_config("embeddings_plot_lims", default="None") 
max_rate_plot                     = read_config("max_rate_plot", default = 1/10000)
max_Ne_plot                       = read_config("max_Ne_plot", default = "None") # Upper limit of the effective-size plot
Ne_plot_scale                     = read_config("Ne_plot_scale", default = "log") # y-axis scale of the effective-size plot, linear or log
generation_time                   = read_config("generation_time", default = "None") # Years per generation; adds a years axis to the effective-size plot
embeddings_max_time               = read_config("embeddings_max_time", default = rates_max_time) # Defaults to the deepest timepoint the rates actually carry
time_scale                        = read_config("time_scale", default = "linear")

# Empirical dataset parameters
pops                              = read_config("pops", "all").replace(","," ")
n_samples_per_pop                 = read_config("n_samples_per_pop", -1)
subsample_seed                    = read_config("subsample_seed", default = 0) # Seed for random subsampling in preprocess_samples (empirical runs only)
# raw_pop_colors/raw_pop_labels are the user-supplied metadata files for empirical runs (unused in simulation mode).
# pop_colors/pop_labels always point at the run-local, already-sliced copies that downstream rules consume.
raw_pop_colors                    = read_config("pop_colors", default = "")
raw_pop_labels                    = read_config("pop_labels", default = "")
pop_colors                        = os.path.join(output_path, "data/pop_colors.csv")
pop_labels                        = os.path.join(output_path, "data/pop_labels.csv")

# Admixture Parameters
admixed_pops                      = read_config("admixed_pops", default=None)
reference_pops                    = read_config("reference_pops", default=None)
significant_ancestry_threshold    = read_config("significant_ancestry_threshold", default=0.1)
LAI_method                        = str(read_config("LAI_method", default="GNN"))

# Local ancestry inference method: RFmix (src/LocalAncestryRFmix.py), GNN
# (src/LocalAncestryGNN.py), or True (ground-truth calls emitted by
# simulate_trees.py alongside the simulated trees). LAI and ancestry_STT
# outputs are namespaced by method so the three can coexist in one output_path.
LAI_METHODS = ["RFmix", "GNN", "True"]
if LAI_method not in LAI_METHODS:
    raise ValueError(f"LAI_method={LAI_method!r} is not one of {LAI_METHODS}.")

# Reference-panel labels become directory names under ancestry_STT/, snakemake
# {ancestry} wildcards, "<label>_prop" parquet columns and fields in RFmix's
# tab-delimited sample map, so the charset has to satisfy all four at once.
_LABEL_RE = re.compile(r"^[A-Za-z0-9_.-]+$")

def _to_list(x):
    if x is None: return None
    if isinstance(x, list): return [str(v).strip() for v in x]
    if isinstance(x, dict):
        raise TypeError("_to_list received a dict; reference_pops goes through _to_reference_spec.")
    return [v.strip() for v in str(x).replace(",", " ").split() if v.strip()]

def _to_reference_spec(x):
    """Normalize reference_pops into {label: {source_pop: n_individuals} | None} | None.

    Three accepted spellings collapse to one internal form, so there is a single
    code path downstream:

        None                        -> None   (default: every non-admixed population,
                                                all samples; resolved at runtime)
        ["A", "B"] / "A B" / "A,B"  -> {"A": None, "B": None}
        {"G": {"P": n, ...}}        -> itself

    A value of None inside the dict means "all samples of the population named by
    the key", i.e. the legacy meaning for that one group. Mixing the two is legal
    and useful: balance the groups that need it, take everything for the rest.
    Counts are DIPLOID INDIVIDUALS; both haplotypes of each enter the panel.
    """
    if x is None:
        return None
    # `--config reference_pops='{...}'` arrives as a string, not a mapping.
    if isinstance(x, str) and x.lstrip().startswith("{"):
        x = json.loads(x)
    if isinstance(x, dict):
        spec = {}
        for label, members in x.items():
            label = str(label).strip()
            if members is None:
                spec[label] = None
            elif isinstance(members, dict):
                if not members:
                    raise ValueError(f"reference_pops['{label}'] is an empty mapping.")
                spec[label] = {str(p).strip(): n for p, n in members.items()}
            else:
                raise TypeError(
                    f"reference_pops['{label}'] must map source_population -> number of "
                    f"individuals (or be empty for 'all samples of {label}'); got "
                    f"{type(members).__name__}: {members!r}"
                )
        return spec
    return {p: None for p in _to_list(x)}

admixed_pops_list   = _to_list(admixed_pops)
reference_pops_spec = _to_reference_spec(reference_pops)   # stays None if unspecified — infer_local_ancestry.py defaults it at runtime
reference_pops_list = None if reference_pops_spec is None else list(reference_pops_spec.keys())
admix_mode          = admixed_pops_list is not None and len(admixed_pops_list) > 0
pops_list           = None if pops == "all" else pops.split()   # reuse existing `pops` var (already space-joined)

if reference_pops_spec is not None:
    if not reference_pops_spec:
        raise ValueError("reference_pops is empty; omit the key to default to all non-admixed populations.")
    _claimed_sources = {}   # source population -> the label that already took it
    for _label, _members in reference_pops_spec.items():
        if not _LABEL_RE.match(_label):
            raise ValueError(
                f"reference_pops label {_label!r} must match [A-Za-z0-9_.-]+ . Labels become "
                "directory names under ancestry_STT/, snakemake {ancestry} wildcards, "
                "'<label>_prop' parquet columns and tab-delimited RFmix sample-map fields, so "
                "'/', whitespace and tabs are not usable."
            )
        if _label.endswith("_prop"):
            raise ValueError(
                f"reference_pops label {_label!r} must not end in '_prop': select_ancestry_samples.py "
                "recovers the labels by stripping that suffix from the '<label>_prop' columns of "
                "total_ancestry_proportions.parquet."
            )
        # A group with no member mapping draws from the one population it names.
        _sources = [_label] if _members is None else list(_members)
        if _members is not None:
            for _p, _n in _members.items():
                # bool is an int subclass, so `True` would otherwise pass as 1.
                if isinstance(_n, bool) or not isinstance(_n, int) or _n <= 0:
                    raise ValueError(
                        f"reference_pops['{_label}']['{_p}'] must be a positive integer number of "
                        f"diploid individuals; got {_n!r}."
                    )
        if pops_list is not None:
            _bad = [p for p in _sources if p not in pops_list]
            if _bad:
                raise ValueError(
                    f"reference_pops['{_label}'] draws from {_bad}, which are not in pops={pops_list}; "
                    "every source population must be a subset of pops."
                )
        if admixed_pops_list:
            _bad = [p for p in _sources if p in admixed_pops_list]
            if _bad:
                raise ValueError(
                    f"reference_pops['{_label}'] draws from admixed populations {_bad}; a reference "
                    "panel cannot contain admixed samples."
                )
        for _p in _sources:
            if _p in _claimed_sources:
                raise ValueError(
                    f"reference_pops: source population {_p!r} appears in both "
                    f"'{_claimed_sources[_p]}' and '{_label}'. Reference panels must be disjoint: GNN "
                    "takes an argmax over the panels and RFmix assigns one label per individual, so "
                    "overlapping panels are undefined rather than merely redundant."
                )
            _claimed_sources[_p] = _label

if admix_mode and pops_list is not None:
    _bad_admixed = [p for p in admixed_pops_list if p not in pops_list]
    if _bad_admixed:
        raise ValueError(f"admixed_pops {_bad_admixed} not in pops={pops_list}; admixed_pops must be a subset of pops.")
    # reference_pops source populations are checked above; when reference_pops is
    # None the restriction is deferred to infer_local_ancestry.py via --pops.

# Ground-truth ancestry labels come from msprime census nodes and are always
# atomic deme names, so a composite label would never appear in the LAI parquets:
# every proportion would be 0 and the normalisation would produce NaN.
_is_composite_reference = (
    reference_pops_spec is not None and any(v is not None for v in reference_pops_spec.values())
)
if admix_mode and LAI_method == "True" and _is_composite_reference:
    raise ValueError(
        "LAI_method='True' cannot be combined with composite reference_pops. The composite labels "
        f"{[k for k, v in reference_pops_spec.items() if v is not None]} would never appear in the "
        "ground-truth local ancestry calls, whose labels are always atomic deme names. Use "
        "LAI_method='RFmix' or 'GNN', or give reference_pops as a plain list of deme names."
    )

# True local ancestry only exists for simulated trees: it is derived from the
# msprime census nodes written by simulate_trees.py, so it requires a demes
# file and a trees_dir that this run actually simulates into.
if admix_mode and LAI_method == "True":
    if not demes_file_path:
        raise ValueError("LAI_method='True' requires a simulation: set demes_file_path in the config.")
    if trees_dir != tree_output_path:
        raise ValueError(
            f"LAI_method='True' requires trees simulated by this run, but trees_dir={trees_dir} "
            f"is external (expected {tree_output_path}). Use LAI_method='RFmix' or 'GNN' instead."
        )

# Replicate optimization seeds (optional; used only by compute_embeddings_replicates rule)
seeds                             = read_config("seeds", default = [])

# Scan Parameters (optional; scan_p/scan_d rules only activate if their respective config keys are all present)
min_p                             = read_config("min_p", default=None)
max_p                             = read_config("max_p", default=None)
num_p                             = read_config("num_p", default=None)
min_d                             = read_config("min_d", default=None)
max_d                             = read_config("max_d", default=None)
num_d                             = read_config("num_d", default=None)
scan_p_mode                       = min_p is not None and max_p is not None and num_p is not None
scan_d_mode                       = min_d is not None and max_d is not None and num_d is not None

# Parameter label for plot titles (optional — pass to --param_label in plotting rules)
_l1_str = f" | l1={l1_penalties}" if l1_penalties != "None" else ""
param_label = (
    f"n={n_samples_per_pop}/pop | "
    f"N=[{N_min}, {N_max}] | "
    f"link={link} | "
    f"window size=[{min_window_size}, {max_window_size}]"
    f"{_l1_str}"
)

# Filename Tags
SIM_TAG                           = f".NC{num_contigs}.CL{contig_length}.NPP{n_sim_per_pop}"
PDF_TAG                           = f".V{version}.FS{fraction_samples}.pdf_minT{pdf_min_time}.pdf_maxT{pdf_max_time}.pdf_bin{pdf_bin_size}"
# per_haplotype changes what a row IS -- a haplotype pair rather than an individual
# pair -- by changing where _pooled_survival pools, so the rates, their weights, the
# embeddings and every plot downstream all differ. It belongs from RATES_TAG down
# rather than in PDF_TAG: the pdf is per-sample-pair either way, which is what lets
# one pdf serve both settings.
PHASE_TAG                         = ".perHap" if per_haplotype else ""
RATES_TAG                         = f".minWS{min_window_size}.maxWS{max_window_size}.rates_minT{rates_min_time}.rates_maxT{rates_max_time}{PHASE_TAG}" + PDF_TAG
# True rates are an analytic function of the demography on the rates grid: they
# depend on that grid and on per_haplotype (which sets whether rows are sample or
# individual pairs), but on none of the estimation parameters (window sizes, the
# pdf extent, the embedding). Tagging them with only what they depend on keeps a
# grid change from silently reusing a stale file, which it did when untagged.
TRUE_RATES_TAG                    = f".rates_minT{rates_min_time}.rates_maxT{rates_max_time}.pdf_bin{pdf_bin_size}{PHASE_TAG}"
# PCA is a genotype GRM over the tree sequences and takes no time argument at all,
# so it is deliberately NOT tagged with the time grid; doing so only forced
# pointless recomputes whenever the grid moved.
PCA_TAG                           = f".V{version}"
# STT_TAG (and everything built on it) is penalty-free: it tags the *unsmoothed* embeddings, which
# are always computed regardless of whether smoothing is requested. Smoothed outputs use SMOOTH_TAG,
# which is identical but carries the actual L1 penalties.
STT_TAG                           = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.p{p}.link{link}.L1[None].nTe{n_timepoints_emb}" + RATES_TAG
SMOOTH_TAG                        = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.p{p}.link{link}.L1[{l1_penalties}].nTe{n_timepoints_emb}" + RATES_TAG
PLOT_TAG                          = f".minTPlot{embeddings_min_time}.maxTPlot{embeddings_max_time}.xylims{embeddings_plot_lims}" + STT_TAG
SMOOTH_PLOT_TAG                   = f".minTPlot{embeddings_min_time}.maxTPlot{embeddings_max_time}.xylims{embeddings_plot_lims}" + SMOOTH_TAG
# Built on TRUE_RATES_TAG rather than STT_TAG: embeddings of the true rates use no
# window sizes and no pdf, so carrying minWS/maxWS/nTe/p/link in their names was
# claiming a dependence that does not exist.
TRUE_TAG                          = f".d{n_components}.Nmin{N_min}.Nmax{N_max}" + TRUE_RATES_TAG
# STT_TAG with the swept field omitted, for use by the scan_p/scan_d rules (the value varies within the rule, so it can't appear in a single output filename). Scans run unsmoothed, so these are penalty-free too.
STT_TAG_NO_P                      = f".d{n_components}.Nmin{N_min}.Nmax{N_max}.link{link}.L1[None].nTe{n_timepoints_emb}" + RATES_TAG
STT_TAG_NO_D                      = f".Nmin{N_min}.Nmax{N_max}.p{p}.link{link}.L1[None].nTe{n_timepoints_emb}" + RATES_TAG

# Whether smoothing (joint optimization) is requested — gates the parallel smoothed rules/targets
smoothing_on                      = l1_penalties != "None"

# Directory holding the wrapper scripts this workflow invokes. All paths in this file are
# resolved against the working directory, which is always utils/.
UTILS_DIR                         = "snakemake_utils"
# Absolute form of UTILS_DIR, baked into the generated dash launchers so they can be
# run from any directory rather than only from utils/.
UTILS_DIR_ABS                     = os.path.abspath(UTILS_DIR)

